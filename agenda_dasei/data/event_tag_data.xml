<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Location Type Tag Category -->
        <record id="event_tag_category_location_type" model="event.tag.category">
            <field name="name">Location Type</field>
            <field name="sequence">100</field>
        </record>

        <!-- Location Type Tags -->
        <record id="event_tag_online" model="event.tag">
            <field name="name">Online</field>
            <field name="category_id" ref="event_tag_category_location_type"/>
            <field name="sequence">10</field>
            <field name="color">3</field><!-- green -->
        </record>

