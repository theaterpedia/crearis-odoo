<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 
        DASEi Grundkurs Product Templates (Event Packages)
        
        These are the 4 module products for the Grundkurs program:
        - Modul A (dasei1): Entry-level, A0-A5 event types
        - Modul B (dasei2): Szenische Themenarbeit, B1-B8 event types
        - Modul C (dasei2): Pädagogische Regie, C0-C8 event types
        - Modul D (dasei2): Kolloquium & Projekt, D0-D4 event types
        
        Note: website_id and package_event_type_ids are set by post_init_hook
        after websites and event types are created/synced.
    -->

    <!-- ═══════════════════════════════════════════════════════════════════════
         MODUL A: Einstiege in's Theaterspiel (dasei1)
         Entry-level module - sold on dasei1 website
         ═══════════════════════════════════════════════════════════════════════ -->
    <record id="product_modul_a" model="product.template">
        <field name="name">Modul A: Einstiege in's Theaterspiel</field>
        <field name="detailed_type">event_package</field>
        <field name="list_price">1100.00</field>
        <field name="description_sale">Modul A umfasst 6 Sessions (A0-A5) und bildet den Einstieg in die Theaterpädagogik-Ausbildung.</field>
        <field name="package_edition_code">M18E</field>
        <!-- website_id: dasei1, package_event_type_ids: A0-A5 (set by hook) -->
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════════
         MODUL B: Szenische Themenarbeit (dasei2)
         Sold on dasei2 website, requires Modul A completion
         ═══════════════════════════════════════════════════════════════════════ -->
    <record id="product_modul_b" model="product.template">
        <field name="name">Modul B: Szenische Themenarbeit</field>
        <field name="detailed_type">event_package</field>
        <field name="list_price">1320.00</field>
        <field name="description_sale">Modul B (JAN-MAI 2027) - Szenische Themenarbeit mit 6-8 Sessions.</field>
        <field name="package_edition_code">M18B</field>
        <!-- website_id: dasei2, package_event_type_ids: B1-B8 (set by hook) -->
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════════
         MODUL C: Pädagogische Regie (dasei2)
         Sold on dasei2 website
         ═══════════════════════════════════════════════════════════════════════ -->
    <record id="product_modul_c" model="product.template">
        <field name="name">Modul C: Pädagogische Regie</field>
        <field name="detailed_type">event_package</field>
        <field name="list_price">1320.00</field>
        <field name="description_sale">Modul C (JUN-DEZ 2027) - Pädagogische Regie mit 6-8 Sessions.</field>
        <field name="package_edition_code">M18C</field>
        <!-- website_id: dasei2, package_event_type_ids: C0-C8 (set by hook) -->
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════════
         MODUL D: Kolloquium & Projekt (dasei2)
         Sold on dasei2 website
         ═══════════════════════════════════════════════════════════════════════ -->
    <record id="product_modul_d" model="product.template">
        <field name="name">Modul D: Kolloquium, Zielgruppenpraxis, Projekt</field>
        <field name="detailed_type">event_package</field>
        <field name="list_price">1100.00</field>
        <field name="description_sale">Modul D (JAN-JUL 2028) - Abschlussmodul mit Kolloquium und Projektarbeit.</field>
        <field name="package_edition_code">M18D</field>
        <!-- website_id: dasei2, package_event_type_ids: D0-D4 (set by hook) -->
    </record>

</odoo>
