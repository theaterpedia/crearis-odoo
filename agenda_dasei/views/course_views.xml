<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- DASEi Course Tree View -->
    <record id="view_dasei_course_tree" model="ir.ui.view">
        <field name="name">dasei.course.tree</field>
        <field name="model">dasei.course</field>
        <field name="arch" type="xml">
            <tree string="Courses">
                <field name="code"/>
                <field name="name"/>
                <field name="year"/>
                <field name="location"/>
                <field name="participant_count"/>
                <field name="date_start" optional="hide"/>
                <field name="date_end" optional="hide"/>
            </tree>
        </field>
    </record>

    <!-- DASEi Course Form View -->
    <record id="view_dasei_course_form" model="ir.ui.view">
        <field name="name">dasei.course.form</field>
        <field name="model">dasei.course</field>
        <field name="arch" type="xml">
            <form string="Course">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="code" placeholder="Course Code"/>
                        </h1>
                        <h2>
                            <field name="name" placeholder="Course Name"/>
                        </h2>
                    </div>
                    <group>
                        <group>
                            <field name="year"/>
                            <field name="location"/>
                            <field name="domain_code_id"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="participant_count"/>
                        </group>
                    </group>
                    <group string="SharePoint Sync" groups="base.group_no_one">
                        <field name="ms_item_id" readonly="1"/>
                        <field name="ms_etag" readonly="1"/>
                        <field name="company_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- DASEi Course Search View -->
    <record id="view_dasei_course_search" model="ir.ui.view">
        <field name="name">dasei.course.search</field>
        <field name="model">dasei.course</field>
        <field name="arch" type="xml">
            <search string="Courses">
                <field name="code"/>
                <field name="name"/>
                <field name="location"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Year" name="group_year" context="{'group_by': 'year'}"/>
                    <filter string="Location" name="group_location" context="{'group_by': 'location'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- DASEi Course Action -->
    <record id="action_dasei_course" model="ir.actions.act_window">
        <field name="name">Courses</field>
        <field name="res_model">dasei.course</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_dasei_course_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No courses found
            </p>
            <p>
                Courses represent annual training cohorts (K26, K27, etc.)
                synced from SharePoint plan_kurse.
            </p>
        </field>
    </record>

    <!-- Menu Item under DASEi Data -->
    <menuitem id="menu_dasei_course"
              name="Courses"
              parent="menu_dasei_data"
              action="action_dasei_course"
              sequence="5"/>
</odoo>
