# Translation of Odoo Server.
# This file contains the translation of the following modules:
# 	* crearis_milestones
#
# Scope: mail.template subject + body_html only (participant-facing milestone
# emails). The module's remaining UI terms are not yet translated; a partial
# .po is valid and Odoo imports only the entries present.
#
# Tone follows the house style of crearis mail templates 39/40/42:
# "Hallo <name>," / consistent du-form / closing "Liebe Grüße," (HM-2026-08-04).
# QWeb expressions are intentionally identical to the source -- a translation
# must not change behaviour.
#
msgid ""
msgstr ""
"Project-Id-Version: Odoo Server 16.0\n"
"Report-Msgid-Bugs-To: \n"
"Last-Translator: \n"
"Language-Team: \n"
"Language: de\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: \n"
"Plural-Forms: \n"

#. module: crearis_milestones
#: model:mail.template,body_html:crearis_milestones.mail_template_milestone_activation
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 14px;\">\n"
"    <p>Hello {{ object.partner_id.name or object.name }},</p>\n"
"    \n"
"    <p>Your registration for <strong>{{ object.event_id.name }}</strong> has been confirmed.</p>\n"
"    \n"
"    <table style=\"margin: 20px 0; border-collapse: collapse;\">\n"
"        <tr>\n"
"            <td style=\"padding: 5px 15px 5px 0; color: #666;\">Event:</td>\n"
"            <td style=\"padding: 5px 0;\"><strong>{{ object.event_id.name }}</strong></td>\n"
"        </tr>\n"
"        <tr>\n"
"            <td style=\"padding: 5px 15px 5px 0; color: #666;\">Date:</td>\n"
"            <td style=\"padding: 5px 0;\">{{ object.event_id.date_begin.strftime('%d.%m.%Y') }}</td>\n"
"        </tr>\n"
"        <tr>\n"
"            <td style=\"padding: 5px 15px 5px 0; color: #666;\">Location:</td>\n"
"            <td style=\"padding: 5px 0;\">{{ object.event_id.address_id.city or 'Online' }}</td>\n"
"        </tr>\n"
"    </table>\n"
"    \n"
"    <p>We look forward to seeing you!</p>\n"
"    \n"
"    <p>Best regards,<br>\n"
"    {{ object.event_id.organizer_id.name or object.event_id.company_id.name }}</p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px; font-size: 14px;\">\n"
"    <p>Hallo {{ object.partner_id.name or object.name }},</p>\n"
"    \n"
"    <p>Deine Anmeldung für <strong>{{ object.event_id.name }}</strong> ist bestätigt.</p>\n"
"    \n"
"    <table style=\"margin: 20px 0; border-collapse: collapse;\">\n"
"        <tr>\n"
"            <td style=\"padding: 5px 15px 5px 0; color: #666;\">Veranstaltung:</td>\n"
"            <td style=\"padding: 5px 0;\"><strong>{{ object.event_id.name }}</strong></td>\n"
"        </tr>\n"
"        <tr>\n"
"            <td style=\"padding: 5px 15px 5px 0; color: #666;\">Datum:</td>\n"
"            <td style=\"padding: 5px 0;\">{{ object.event_id.date_begin.strftime('%d.%m.%Y') }}</td>\n"
"        </tr>\n"
"        <tr>\n"
"            <td style=\"padding: 5px 15px 5px 0; color: #666;\">Ort:</td>\n"
"            <td style=\"padding: 5px 0;\">{{ object.event_id.address_id.city or 'Online' }}</td>\n"
"        </tr>\n"
"    </table>\n"
"    \n"
"    <p>Wir freuen uns auf dich!</p>\n"
"    \n"
"    <p>Liebe Grüße,<br>\n"
"    {{ object.event_id.organizer_id.name or object.event_id.company_id.name }}</p>\n"
"</div>\n"
"            "

#. module: crearis_milestones
#: model:mail.template,body_html:crearis_milestones.mail_template_milestone_completion
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 14px;\">\n"
"    <p>Hello {{ object.partner_id.name or object.name }},</p>\n"
"    \n"
"    <p>Thank you for participating in <strong>{{ object.event_id.name }}</strong>!</p>\n"
"    \n"
"    <p>We hope you found the experience valuable and look forward to seeing you again.</p>\n"
"    \n"
"    <p>Best regards,<br>\n"
"    {{ object.event_id.organizer_id.name or object.event_id.company_id.name }}</p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px; font-size: 14px;\">\n"
"    <p>Hallo {{ object.partner_id.name or object.name }},</p>\n"
"    \n"
"    <p>danke, dass du bei <strong>{{ object.event_id.name }}</strong> dabei warst!</p>\n"
"    \n"
"    <p>Wir hoffen, es war eine wertvolle Erfahrung für dich – und freuen uns, wenn wir dich wiedersehen.</p>\n"
"    \n"
"    <p>Liebe Grüße,<br>\n"
"    {{ object.event_id.organizer_id.name or object.event_id.company_id.name }}</p>\n"
"</div>\n"
"            "

