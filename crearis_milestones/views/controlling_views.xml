<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- 
    Controlling Dashboard Views
    
    Main UI for coordinators (Eleanora) to manage milestones.
    Groups registrations by event = Milestone level.
    Individual registrations = Check level.
    
    See: architecture_milestones_and_actions.md "Für Anwender"
    
    Terminology:
    - Meilenstein = Event group header (e.g., "A3 — Meldefrist 14.11")
    - Check / TN = Individual registration line
    - BEREIT = Ready to confirm (no blockers)
    - TRIAGE = Has blockers, needs attention
    -->
    
    <!-- Controlling Tree View (grouped by event = milestone) -->
    <record id="view_registration_controlling_tree" model="ir.ui.view">
        <field name="name">event.registration.controlling.tree</field>
        <field name="model">event.registration</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <tree decoration-success="check_state == 'sent'"
                  decoration-warning="check_state == 'issue' or has_blockers"
                  decoration-muted="check_state == 'pending'">
                <!-- Hidden fields for grouping/filtering -->
                <field name="event_id" invisible="1"/>
                <field name="has_blockers" invisible="1"/>
                
                <!-- Main columns -->
                <field name="partner_id" string="Participant"/>
                <field name="check_state" widget="badge"
                       decoration-muted="check_state == 'pending'"
                       decoration-info="check_state == 'ready'"
                       decoration-success="check_state == 'sent'"
                       decoration-danger="check_state == 'issue'"/>
                <field name="blocker_summary" string="⚠️" 
                       attrs="{'invisible': [('has_blockers', '=', False)]}"/>
                <field name="check_comment" string="Notes" optional="show"/>
                
                <!-- Action buttons -->
                <button name="action_confirm_check" 
                        string="✓" 
                        type="object"
                        title="Confirm"
                        class="btn-link text-success"
                        attrs="{'invisible': ['|', ('check_state', '!=', 'ready'), ('has_blockers', '=', True)]}"/>
                <button name="action_show_blockers" 
                        string="⚠️" 
                        type="object"
                        title="Show Blockers"
                        class="btn-link text-warning"
                        attrs="{'invisible': [('has_blockers', '=', False)]}"/>
                <button name="action_confirm_override" 
                        string="⚡" 
                        type="object"
                        title="Override"
                        class="btn-link text-danger"
                        attrs="{'invisible': ['|', ('check_state', 'not in', ['ready', 'issue']), ('has_blockers', '=', False)]}"/>
            </tree>
        </field>
    </record>
    
    <!-- Controlling Search View -->
    <record id="view_registration_controlling_search" model="ir.ui.view">
        <field name="name">event.registration.controlling.search</field>
        <field name="model">event.registration</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="event_id"/>
                <field name="check_comment"/>
                
                <!-- State filters -->
                <separator/>
                <filter name="bereit" string="✓ Bereit" 
                        domain="[('check_state', '=', 'ready'), ('has_blockers', '=', False)]"/>
                <filter name="triage" string="⚠️ Triage" 
                        domain="['|', ('check_state', '=', 'issue'), ('has_blockers', '=', True)]"/>
                <filter name="sent" string="✉️ Gesendet" 
                        domain="[('check_state', '=', 'sent')]"/>
                <filter name="pending" string="⏳ Ausstehend" 
                        domain="[('check_state', '=', 'pending')]"/>
                
                <!-- Blocker filters -->
                <separator/>
                <filter name="has_blockers" string="Mit Blockern" 
                        domain="[('has_blockers', '=', True)]"/>
                
                <!-- Date filters -->
                <separator/>
                <filter name="this_week" string="Diese Woche"
                        domain="[('event_id.date_begin', '!=', False)]"/>
                
                <!-- Group by -->
                <group expand="1" string="Group By">
                    <filter name="group_by_event" string="Event (Milestone)" 
                            context="{'group_by': 'event_id'}"/>
                    <filter name="group_by_state" string="Check State" 
                            context="{'group_by': 'check_state'}"/>
                    <filter name="group_by_partner" string="Partner" 
                            context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>
    
    <!-- Controlling Action (main entry point) -->
    <record id="action_registration_controlling" model="ir.actions.act_window">
        <field name="name">Controlling</field>
        <field name="res_model">event.registration</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_registration_controlling_tree"/>
        <field name="search_view_id" ref="view_registration_controlling_search"/>
        <field name="domain">[('state', '=', 'open'), ('check_state', 'in', ['ready', 'issue'])]</field>
        <field name="context">{
            'search_default_group_by_event': 1,
            'search_default_bereit': 1,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                All milestone checks complete!
            </p>
            <p>
                No registrations need confirmation right now.
                Checks appear here when milestones become ready.
            </p>
        </field>
    </record>
    
    <!-- Server Action: Bulk confirm all ready (no blockers) -->
    <record id="action_confirm_all_ready" model="ir.actions.server">
        <field name="name">Alle bestätigen</field>
        <field name="model_id" ref="event.model_event_registration"/>
        <field name="binding_model_id" ref="event.model_event_registration"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
if records:
    action = records.action_confirm_all_ready()
        </field>
    </record>
    
    <!-- Menu Items -->
    <menuitem id="menu_controlling_root"
              name="Controlling"
              parent="event.event_main_menu"
              sequence="5"/>
    
    <menuitem id="menu_controlling_dashboard"
              name="Meilensteine"
              parent="menu_controlling_root"
              action="action_registration_controlling"
              sequence="10"/>
    
    <menuitem id="menu_controlling_blockers"
              name="Blockers"
              parent="menu_controlling_root"
              action="action_agenda_line_blocker"
              sequence="20"/>

    <!-- ========================================================== -->
    <!-- F1 Extended: 4-Section Controlling Dashboard               -->
    <!-- Sections: Milestones | Info-Mail | Hot Phase | Wrap-Up     -->
    <!-- ========================================================== -->
    
    <!-- Section 2: Info-Mail Phase -->
    <record id="action_controlling_info_mail" model="ir.actions.act_window">
        <field name="name">📧 Info-Mail Phase</field>
        <field name="res_model">event.registration</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_registration_controlling_tree"/>
        <field name="search_view_id" ref="view_registration_controlling_search"/>
        <field name="domain">[
            ('state', '=', 'open'),
            ('event_id.current_milestone_key', '=', 'info_mail')
        ]</field>
        <field name="context">{
            'search_default_group_by_event': 1,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No events in Info-Mail phase
            </p>
            <p>
                Events enter Info-Mail phase 3 weeks before the event date.
                Participants receive course materials and meeting links.
            </p>
        </field>
    </record>
    
    <!-- Section 3: Hot Phase (Event Running) -->
    <record id="action_controlling_hot_phase" model="ir.actions.act_window">
        <field name="name">🔥 Hot Phase</field>
        <field name="res_model">event.registration</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_registration_controlling_tree"/>
        <field name="search_view_id" ref="view_registration_controlling_search"/>
        <field name="domain">[
            ('state', '=', 'open'),
            ('event_id.stage_id.sequence', '=', 4096)
        ]</field>
        <field name="context">{
            'search_default_group_by_event': 1,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No events in Hot Phase
            </p>
            <p>
                Events in Hot Phase are currently running.
                Track attendance and session completion.
            </p>
        </field>
    </record>
    
    <!-- Section 4: Wrap-Up Phase -->
    <record id="action_controlling_wrap_up" model="ir.actions.act_window">
        <field name="name">📦 Wrap-Up Phase</field>
        <field name="res_model">event.registration</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_registration_controlling_tree"/>
        <field name="search_view_id" ref="view_registration_controlling_search"/>
        <field name="domain">[
            ('state', '=', 'open'),
            ('event_id.current_milestone_key', '=', 'wrap_up')
        ]</field>
        <field name="context">{
            'search_default_group_by_event': 1,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No events in Wrap-Up phase
            </p>
            <p>
                Events enter Wrap-Up phase after all sessions complete.
                Send certificates and collect feedback.
            </p>
        </field>
    </record>
    
    <!-- Forced Controlling (manual inclusion) -->
    <record id="action_controlling_forced" model="ir.actions.act_window">
        <field name="name">⚡ Forced Controlling</field>
        <field name="res_model">event.registration</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_registration_controlling_tree"/>
        <field name="search_view_id" ref="view_registration_controlling_search"/>
        <field name="domain">[
            ('state', '=', 'open'),
            ('event_id.forced_controlling', '=', True)
        ]</field>
        <field name="context">{
            'search_default_group_by_event': 1,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No events with forced controlling
            </p>
            <p>
                Events can be manually flagged for controlling dashboard visibility.
            </p>
        </field>
    </record>
    
    <!-- F1 Extended Menu Items -->
    <menuitem id="menu_controlling_info_mail"
              name="📧 Info-Mail"
              parent="menu_controlling_root"
              action="action_controlling_info_mail"
              sequence="15"/>
    
    <menuitem id="menu_controlling_hot_phase"
              name="🔥 Hot Phase"
              parent="menu_controlling_root"
              action="action_controlling_hot_phase"
              sequence="16"/>
    
    <menuitem id="menu_controlling_wrap_up"
              name="📦 Wrap-Up"
              parent="menu_controlling_root"
              action="action_controlling_wrap_up"
              sequence="17"/>
    
    <menuitem id="menu_controlling_forced"
              name="⚡ Forced"
              parent="menu_controlling_root"
              action="action_controlling_forced"
              sequence="25"/>
    
    <!-- ═══════════════════════════════════════════════════════════════════════
         S2L: Two-Lanes Controlling Dashboard (Direction 4)
         Unified view across: agenda.line, calendar.event, crm.lead
         ═══════════════════════════════════════════════════════════════════════ -->
    
    <!-- Dashboard Form View -->
    <record id="view_controlling_dashboard_form" model="ir.ui.view">
        <field name="name">controlling.dashboard.form</field>
        <field name="model">controlling.dashboard</field>
        <field name="arch" type="xml">
            <form string="S2L Dashboard">
                <header>
                    <button name="action_refresh" type="object" string="🔄 Refresh" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>S2L Controlling Dashboard</h1>
                    </div>
                    
                    <!-- Stats Boxes -->
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-list" disabled="1">
                            <field name="line_count" widget="statinfo" string="Total"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-video-camera" disabled="1">
                            <field name="consulting_count" widget="statinfo" string="Calls"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-envelope" disabled="1">
                            <field name="inquiry_count" widget="statinfo" string="Emails"/>
                        </button>
                    </div>
                    
                    <!-- Filters -->
                    <group>
                        <group>
                            <field name="exec_id"/>
                            <field name="domain_code"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                    </group>
                    
                    <!-- Lines -->
                    <notebook>
                        <page string="All Lines" name="lines">
                            <field name="line_ids">
                                <tree decoration-info="source_type == 'inquiry'"
                                      decoration-success="state == 'confirmed'"
                                      decoration-warning="state == 'pending_reconfirm'"
                                      decoration-muted="state == 'cancelled'">
                                    <field name="date"/>
                                    <field name="partner_name"/>
                                    <field name="lane_type" widget="badge"/>
                                    <field name="domain_code"/>
                                    <field name="category_summary"/>
                                    <field name="assigned_exec_id" widget="many2one_avatar_user"/>
                                    <field name="state" widget="badge"/>
                                    <field name="source_type" invisible="1"/>
                                    <button name="action_open_source" type="object" 
                                            string="→" title="Open Source Record"
                                            class="btn-link"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- Dashboard Action -->
    <record id="action_s2l_dashboard" model="ir.actions.act_window">
        <field name="name">S2L Dashboard</field>
        <field name="res_model">controlling.dashboard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>
    
    <!-- Server Action to open fresh dashboard -->
    <record id="action_open_s2l_dashboard" model="ir.actions.server">
        <field name="name">Open S2L Dashboard</field>
        <field name="model_id" ref="model_controlling_dashboard"/>
        <field name="state">code</field>
        <field name="code">
action = env['controlling.dashboard'].action_open_dashboard()
        </field>
    </record>
    
    <!-- Menu Item for S2L Dashboard -->
    <menuitem id="menu_s2l_dashboard"
              name="📊 S2L Dashboard"
              parent="menu_controlling_root"
              action="action_open_s2l_dashboard"
              sequence="5"/>
    
</odoo>
