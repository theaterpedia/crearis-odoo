<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add "Ratenzahlung" button to draft customer invoices -->
    <record id="view_move_form_inherit_installment" model="ir.ui.view">
        <field name="name">account.move.form.inherit.installment</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_post']" position="before">
                <button name="action_open_installment_wizard"
                        string="Ratenzahlung"
                        type="object"
                        class="btn-secondary"
                        attrs="{'invisible': ['|', ('state', '!=', 'draft'), ('move_type', '!=', 'out_invoice')]}"
                        groups="account.group_account_invoice"/>
            </xpath>
        </field>
    </record>

</odoo>
