<?xml version="1.0"?>
<odoo>

<record id="view_blog_post_form" model="ir.ui.view">
    <field name="name">blog.post.form</field>
    <field name="model">blog.post</field>
    <field name="inherit_id" ref="website_blog.view_blog_post_form"/>
    <field name="arch" type="xml">
        <field name="subtitle" position="after">
            <field name="description" placeholder="Teasertext"/>
            <field name="homesite_id" options="{'no_create': True}" groups="website.group_multi_website"/>

            <!--  Crearis-Interface -->
            <field name="header_type" />
            <field name="header_size" />
            
            <label string="-> Image" for="cimg" />
            <div class="o_row">
                <field name="cimg" class="oe_inline" nolabel="1" />
            </div>
            <field name="md" />
            
            <!-- Format Options Section (from web.options.abstract) -->
            <separator string="Format Options" />

            
            <!-- Page + Aside Options Block -->
            <group>
                <group string="Page Options">
                    <field name="page_background" />
                    <field name="page_cssvars" widget="text" />
                    <field name="page_navigation" widget="text" />
                    <field name="page_options_text" />
                </group>
                <group string="Aside Options">
                    <field name="aside_postit" widget="text" />
                    <field name="aside_toc" widget="text" />
                    <field name="aside_list" />
                    <field name="aside_context" widget="text" />
                    <field name="aside_options_text" />
                </group>
            </group>
            
            <!-- Header + Footer Options Block -->
            <group>
                <group string="Header Options">
                    <field name="header_alert" widget="text" />
                    <field name="header_postit" widget="text" />
                    <field name="header_options_text" />
                </group>
                <group string="Footer Options">
                    <field name="footer_gallery" />
                    <field name="footer_postit" widget="text" />
                    <field name="footer_slider" />
                    <field name="footer_repeat" widget="text" />
                    <field name="footer_sitemap" />
                    <field name="footer_options_text" />
                </group>
            </group>
            
            <!-- Save Button -->
            <div class="oe_button_box" name="format_options_actions">
                <button 
                    name="action_save_format_options" 
                    type="object" 
                    string="Save Format Options" 
                    class="btn-primary"
                    icon="fa-save"
                    help="Save all format options to the database"/>
            </div>
            
            <!-- Debug view of raw format_options (optional) -->
            <group string="Raw Format Options (Debug)" groups="base.group_no_one">
                <field name="format_options" widget="json"/>
                <field name="page_options_json" widget="json" readonly="1"/>
                <field name="aside_options_json" widget="json" readonly="1"/>
                <field name="header_options_json" widget="json" readonly="1"/>
                <field name="footer_options_json" widget="json" readonly="1"/>
                <separator string="Example Properties"/>
                <field name="page_prop2" placeholder="val1, val2, val3"/>
                <field name="page_prop3" />
            </group>

        </field>
        <field name="subtitle" position="after">
            <field name="name" position="move"/>
        </field>
        <field name="subtitle" position="replace">
            <field name="subtitle" string="subtitle INAKTIV"/>
        </field>
    </field>
</record>

</odoo>