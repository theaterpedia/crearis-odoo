<odoo>  
    <record id="view_event_form" model="ir.ui.view">
        <field name="name">event.event.form</field>
        <field name="model">event.event</field>
        <field name="priority" eval="50" />
        <field name="inherit_id" ref="event.view_event_form"/>
        <field name="arch" type="xml">

            <!-- Add demo banner at the very top -->
            <xpath expr="//sheet" position="before">
                <div class="ribbon ribbon-top-left" attrs="{'invisible': [('is_demo', '=', False)]}">
                    <span class="bg-success">DEMO DATA</span>
                </div>
            </xpath>

            <xpath expr="//div[@name='button_box']" position="before">
                <!--  render-props-->
                <field name="is_demo" invisible="1"/>
                <field name="owner_company" invisible="1"></field>  
                <field name="use_msteams" invisible="1" />
                <field name="use_jitsi" invisible="1" />
                <field name="use_template_codes" invisible="1" />
                <field name="use_tracks" invisible="1" />
                <field name="use_products" invisible="1" />
                <field name="use_overline" invisible="1" />
                <field name="use_teasertext" invisible="1" />
            </xpath>


        <!--  Button-Boxes -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <!--  Products -->
                <button name="event_products" class="oe_stat_button" icon="fa-microphone" attrs="{'invisible':[('use_products', '=', False)]}">
                    Products
                </button>
                <!--  Channels -->
                <button name="event_products" class="oe_stat_button" icon="fa-microphone" attrs="{'invisible':[('use_msteams', '=', False)]}">
                    Channels
                </button>                
            </xpath>                  

            <!--  Tracks - war: 548 -->
            <xpath expr="//button[@name='330']" position="attributes">
                <attribute name="attrs">
                    {'invisible': [('use_tracks', '=', False)]}
                </attribute>
            </xpath>

            <!--  Rooms - war: 555-->
            <xpath expr="//button[@name='330']" position="attributes">
                <attribute name="attrs">
                    {'invisible': [('use_jitsi', '=', False)]}
                </attribute>
            </xpath>        

            <!--  Website-Button -->
            <xpath expr="//field[@widget='website_redirect_button']" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>

        <!--  Menu-Configuration -->
            <!--  OBS: the same anchor is used for Teaser!! -->
            <xpath expr="//div[@class='oe_title']" position="before">
                <xpath expr="//div[@name='event_menu_configuration']" position="move" />
            </xpath>  

            <xpath expr="//field[@name='use_sessions']" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>

            <xpath expr="//div[@name='event_menu_configuration']" position="inside">
                <br></br>
                <label for="use_sessions" />
                <field name="use_sessions" />
                <label class="ml8" for="create_partner" />
                <field name="create_partner" />
                <label class="ml8" for="forbid_duplicates" />
                <field name="forbid_duplicates" />      
                <hr style="margin-bottom:2em"></hr>                           
            </xpath>      

        <!--  Teaser -->
            <xpath expr="//label[@for='name']" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>
            <xpath expr="//field[@name='event_type_id']" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>            
            
            <!--  Teasertext inside left-content -->
            <xpath expr="//label[@for='date_begin']" position="before">
                <div class="o_row" colspan="2" attrs="{'invisible':[('use_teasertext', '=', False)]}">
                    <field name="teasertext" placeholder="Teasertext" nolabel="1" />
                </div>
                <!-- Units field -->
                <label for="units" />
                <div class="o_row">
                    <field name="units" class="oe_inline" nolabel="1" />
                </div>
            </xpath>
    
        <!--  Left Content -->
            <field name="date_tz" class="oe_inline" position="attributes" >
                <attribute name="invisible">True</attribute>
            </field>

            <xpath expr="//field[@name='date_tz']" position="before">            
                <label for="date_tz" string="Timezone" />
                <div class="o_row">
                    <field name="date_tz" class="oe_inline" nolabel="1" />
                </div>
                <label for="schedule" />
                <field name="schedule" nolabel="1" />
    
                <label string="Header Type+Size" for="header_type" />
                <div class="o_row">
                    <field name="header_type" class="oe_inline" nolabel="1" />
                    <field name="header_size" class="oe_inline" nolabel="1" />
                </div>
                <field name="cimg"/>

                <field name="md" />
            </xpath>

            <!-- Add new Website tab as first tab in notebook -->
            <xpath expr="//notebook" position="inside">
                <page string="Website" name="web_options">
                    
                    <!-- Hidden fields for computed states -->
                    <field name="page_options" invisible="1"/>
                    <field name="aside_options" invisible="1"/>
                    <field name="header_options" invisible="1"/>
                    <field name="footer_options" invisible="1"/>
                    <field name="page_has_content" invisible="1"/>
                    <field name="aside_has_content" invisible="1"/>
                    <field name="header_has_content" invisible="1"/>
                    <field name="footer_has_content" invisible="1"/>
                    <field name="page_has_changes" invisible="1"/>
                    <field name="aside_has_changes" invisible="1"/>
                    <field name="header_has_changes" invisible="1"/>
                    <field name="footer_has_changes" invisible="1"/>
                    
                    <!-- Custom Content Sections with Toggle Buttons -->
                    <separator string="Custom Content Sections"/>
                    
                    <!-- All four button groups in one row -->
                    <group col="4">
                        <div>
                            <button name="action_delete_page_options" 
                                    type="object" 
                                    string="Delete Page Options"
                                    class="btn-danger"
                                    icon="fa-times"
                                    attrs="{'invisible': [('page_has_content', '=', False)]}"
                                    confirm="Are you sure you want to delete all page options?"/>
                            
                            <button name="action_create_page_options" 
                                    type="object" 
                                    string="Create Page Options"
                                    class="btn-primary"
                                    icon="fa-plus"
                                    attrs="{'invisible': [('page_has_content', '=', True)]}"/>
                        </div>
                        
                        <div>
                            <button name="action_delete_aside_options" 
                                    type="object" 
                                    string="Delete Aside Options"
                                    class="btn-danger"
                                    icon="fa-times"
                                    attrs="{'invisible': [('aside_has_content', '=', False)]}"
                                    confirm="Are you sure you want to delete all aside options?"/>
                            
                            <button name="action_create_aside_options" 
                                    type="object" 
                                    string="Create Aside Options"
                                    class="btn-primary"
                                    icon="fa-plus"
                                    attrs="{'invisible': [('aside_has_content', '=', True)]}"/>
                        </div>
                        
                        <div>
                            <button name="action_delete_header_options" 
                                    type="object" 
                                    string="Delete Header Options"
                                    class="btn-danger"
                                    icon="fa-times"
                                    attrs="{'invisible': [('header_has_content', '=', False)]}"
                                    confirm="Are you sure you want to delete all header options?"/>
                            
                            <button name="action_create_header_options" 
                                    type="object" 
                                    string="Create Header Options"
                                    class="btn-primary"
                                    icon="fa-plus"
                                    attrs="{'invisible': [('header_has_content', '=', True)]}"/>
                        </div>
                        
                        <div>
                            <button name="action_delete_footer_options" 
                                    type="object" 
                                    string="Delete Footer Options"
                                    class="btn-danger"
                                    icon="fa-times"
                                    attrs="{'invisible': [('footer_has_content', '=', False)]}"
                                    confirm="Are you sure you want to delete all footer options?"/>
                            
                            <button name="action_create_footer_options" 
                                    type="object" 
                                    string="Create Footer Options"
                                    class="btn-primary"
                                    icon="fa-plus"
                                    attrs="{'invisible': [('footer_has_content', '=', True)]}"/>
                        </div>
                    </group>

                    <!-- Page Options Section -->
                    <div attrs="{'invisible': [('page_has_content', '=', False)]}">
                        <separator string="Page Options"/>
                        <group string="Page Configuration">
                            <group>
                                <field name="page_background"/>
                                <field name="page_cssvars" widget="text"/>
                            </group>
                            <group>
                                <field name="page_navigation" widget="text"/>
                                <field name="page_options_text" widget="text"/>
                            </group>
                        </group>
                    </div>

                    <!-- Aside Options Section -->
                    <div attrs="{'invisible': [('aside_has_content', '=', False)]}">
                        <separator string="Aside Options"/>
                        <group string="Aside Configuration">
                            <group>
                                <field name="aside_postit" widget="text"/>
                                <field name="aside_toc" widget="text"/>
                            </group>
                            <group>
                                <field name="aside_list"/>
                                <field name="aside_context" widget="text"/>
                                <field name="aside_options_text" widget="text"/>
                            </group>
                        </group>
                    </div>

                    <!-- Header Options Section -->
                    <div attrs="{'invisible': [('header_has_content', '=', False)]}">
                        <separator string="Header Options"/>
                        <group string="Header Configuration">
                            <group>
                                <field name="header_alert" widget="text"/>
                            </group>
                            <group>
                                <field name="header_postit" widget="text"/>
                                <field name="header_options_text" widget="text"/>
                            </group>
                        </group>
                    </div>

                    <!-- Footer Options Section -->
                    <div attrs="{'invisible': [('footer_has_content', '=', False)]}">
                        <separator string="Footer Options"/>
                        <group string="Footer Configuration">
                            <group>
                                <field name="footer_gallery"/>
                                <field name="footer_postit" widget="text"/>
                                <field name="footer_slider"/>
                            </group>
                            <group>
                                <field name="footer_repeat" widget="text"/>
                                <field name="footer_sitemap"/>
                                <field name="footer_options_text" widget="text"/>
                            </group>
                        </group>
                    </div>
                    
                </page>
            </xpath>

        </field>
    </record>

</odoo>