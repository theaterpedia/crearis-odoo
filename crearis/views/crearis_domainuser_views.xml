<odoo>
    <record id="view_domainuser_form" model="ir.ui.view">
        <field name="name">Domain User Form</field>
        <field name="model">crearis.domainuser</field>
        <field name="arch" type="xml">
            <form string="Domain User">
                
                <!-- Add demo banner at the very top -->
                <div class="ribbon ribbon-top-left" attrs="{'invisible': [('is_demo', '=', False)]}">
                    <span class="bg-success">DEMO DATA</span>
                </div>
                
                <sheet>
                    <!-- Hidden field for demo detection - MUST be inside sheet -->
                    <field name="is_demo" invisible="1"/>
                    
                    <!-- Header Section with Title as Headline -->
                    <div class="oe_title">
                        <!-- Overline: CID, Domain Code, User, Role, Active -->
                        <div class="o_row" style="margin-bottom: 8px;">
                            <field name="cid" readonly="1" class="oe_inline" style="margin-right: 16px;"/>
                            <field name="domain_code" readonly="1" class="oe_inline" style="margin-right: 16px;"/>
                            <field name="user_id" class="oe_inline" style="margin-right: 16px;"/>
                            <field name="role" class="oe_inline" style="margin-right: 16px;"/>
                            <field name="active" class="oe_inline"/>
                        </div>
                        
                        <!-- Headline: Title (Name) -->
                        <h1>
                            <field name="name" placeholder="Title/Role Name" required="1"/>
                        </h1>
                        
                        <!-- Subline: Description (Two-line text field, wider) -->
                        <div style="max-width: 800px; margin-top: 8px;">
                            <field name="description" 
                                   placeholder="Kurzbeschreibung / Teasertext / Suchmaschine"
                                   style="width: 100%;"
                                   options="{'line_breaks': false}"/>
                        </div>
                        
                        <!-- Domain (important context) -->
                        <div style="margin-top: 12px;">
                            <label for="domain_id" string="Domain: "/>
                            <field name="domain_id" class="oe_inline"/>
                        </div>
                    </div>
                    
                    <!-- Settings Section -->
                    <separator string="Settings"/>
                    <group>
                        <group string="Content">
                            <field name="content_options" widget="text"/>
                            <field name="custom_md"/>
                        </group>                    
                        <group string="Security">
                            <field name="capabilities" placeholder="admin, editor, viewer"/>
                        </group>
                    </group>

                    <!-- Teams Meeting Data (only visible for exec role) -->
                    <div attrs="{'invisible': [('role', '!=', 'exec')]}">
                        <separator string="MS Teams Consulting"/>
                        <group>
                            <group string="Profile">
                                <label string="Photo URL" for="cimg"/>
                                <div class="o_row">
                                    <field name="cimg" class="oe_inline" nolabel="1" placeholder="https://example.com/photo.jpg"/>
                                </div>
                            </group>
                            <group string="Video Call">
                                <!-- Text proxy for Json field (Odoo 16 pattern) -->
                                <field name="teams_meeting_data_text" widget="text"/>
                            </group>
                        </group>
                        <div colspan="2">
                            <p class="text-muted">
                                <b>Format:</b> JSON object with Teams meeting credentials.<br/>
                                <code>{"videocall_url": "https://teams.microsoft.com/meet/...", "videocall_id": "346 085 853", "phonecall_id": "+49 69 677765514,,526798953#", "phonecall_conference_id": "526 798 953#", "passkey": "7UT9cE2B"}</code><br/>
                                - videocall_url: Full Teams meeting URL (for "Zum Meeting beitreten" link)<br/>
                                - videocall_id: Meeting ID for manual entry<br/>
                                - passkey: Meeting passcode<br/>
                                - phonecall_id: Dial-in phone number (optional)<br/>
                                - phonecall_conference_id: Phone conference ID (optional)<br/>
                                <em>Note: HTML is computed automatically from these fields.</em>
                            </p>
                        </div>
                    </div>

                    
                    <!-- Body Section (only visible if custom_md is true) -->
                    <div attrs="{'invisible': [('custom_md', '=', False)]}">
                        <separator string="Body"/>
                        <group>
                            <field name="md" widget="text" placeholder="Enter markdown content here..."/>
                        </group>
                    </div>                    

                    <!-- Custom Content Sections with Toggle Buttons -->
                    <separator string="Custom Content Sections"/>
                    
                    <!-- Hidden fields for computed states -->
                    <field name="page_has_content" invisible="1"/>
                    <field name="aside_has_content" invisible="1"/>
                    <field name="header_has_content" invisible="1"/>
                    <field name="footer_has_content" invisible="1"/>
                    <field name="page_has_changes" invisible="1"/>
                    <field name="aside_has_changes" invisible="1"/>
                    <field name="header_has_changes" invisible="1"/>
                    <field name="footer_has_changes" invisible="1"/>
                    
                    <group>
                        <!-- Page Options Button -->
                        <group>
                            <label for="page_options" string="Page Options"/>
                            <div class="o_row">
                                <!-- Delete button (shown when has content) -->
                                <button name="action_delete_page_options" 
                                        type="object" 
                                        string="Delete Page Options"
                                        class="btn-danger"
                                        icon="fa-times"
                                        attrs="{'invisible': [('page_has_content', '=', False)]}"
                                        confirm="Are you sure you want to delete all page options?"/>
                                
                                <!-- Create button (shown when no content) -->
                                <button name="action_create_page_options" 
                                        type="object" 
                                        string="Create Page Options"
                                        class="btn-primary"
                                        icon="fa-plus"
                                        attrs="{'invisible': [('page_has_content', '=', True)]}"/>
                            </div>
                        </group>
                        
                        <!-- Aside Options Button -->
                        <group>
                            <label for="aside_options" string="Aside Options"/>
                            <div class="o_row">
                                <button name="action_delete_aside_options" 
                                        type="object" 
                                        string="Delete Aside Options"
                                        class="btn-danger"
                                        icon="fa-times"
                                        attrs="{'invisible': [('aside_has_content', '=', False)]}"
                                        confirm="Are you sure you want to delete all aside options?"/>
                                
                                <button name="action_create_aside_options" 
                                        type="object" 
                                        string="Create Aside Options"
                                        class="btn-primary"
                                        icon="fa-plus"
                                        attrs="{'invisible': [('aside_has_content', '=', True)]}"/>
                            </div>
                        </group>
                    </group>
                    
                    <group>
                        <!-- Header Options Button -->
                        <group>
                            <label for="header_options" string="Header Options"/>
                            <div class="o_row">
                                <button name="action_delete_header_options" 
                                        type="object" 
                                        string="Delete Header Options"
                                        class="btn-danger"
                                        icon="fa-times"
                                        attrs="{'invisible': [('header_has_content', '=', False)]}"
                                        confirm="Are you sure you want to delete all header options?"/>
                                
                                <button name="action_create_header_options" 
                                        type="object" 
                                        string="Create Header Options"
                                        class="btn-primary"
                                        icon="fa-plus"
                                        attrs="{'invisible': [('header_has_content', '=', True)]}"/>
                            </div>
                        </group>
                        
                        <!-- Footer Options Button -->
                        <group>
                            <label for="footer_options" string="Footer Options"/>
                            <div class="o_row">
                                <button name="action_delete_footer_options" 
                                        type="object" 
                                        string="Delete Footer Options"
                                        class="btn-danger"
                                        icon="fa-times"
                                        attrs="{'invisible': [('footer_has_content', '=', False)]}"
                                        confirm="Are you sure you want to delete all footer options?"/>
                                
                                <button name="action_create_footer_options" 
                                        type="object" 
                                        string="Create Footer Options"
                                        class="btn-primary"
                                        icon="fa-plus"
                                        attrs="{'invisible': [('footer_has_content', '=', True)]}"/>
                            </div>
                        </group>
                    </group>

                    <!-- Page Options Section (visible if has content) -->
                    <div attrs="{'invisible': [('page_has_content', '=', False)]}">
                        <separator string="Page Options"/>
                        <group string="Page Configuration">
                            <group>
                                <field name="page_background"/>
                                <field name="page_cssvars" widget="text"/>
                            </group>
                            <group>
                                <field name="page_navigation" widget="text"/>
                                <field name="page_options_text" widget="text"/>
                            </group>
                        </group>
                    </div>

                    <!-- Aside Options Section -->
                    <div attrs="{'invisible': [('aside_has_content', '=', False)]}">
                        <separator string="Aside Options"/>
                        <group string="Aside Configuration">
                            <group>
                                <field name="aside_postit" widget="text"/>
                                <field name="aside_toc" widget="text"/>
                            </group>
                            <group>
                                <field name="aside_list"/>
                                <field name="aside_context" widget="text"/>
                                <field name="aside_options_text" widget="text"/>
                            </group>
                        </group>
                    </div>

                    <!-- Header Options Section -->
                    <div attrs="{'invisible': [('header_has_content', '=', False)]}">
                        <separator string="Header Options"/>
                        <group string="Header Configuration">
                            <group>
                                <field name="header_type"/>
                                <field name="header_size"/>
                                <label string="Hero Image" for="cimg"/>
                                <div class="o_row">
                                    <field name="cimg" class="oe_inline" nolabel="1" placeholder="https://example.com/image.jpg"/>
                                </div>
                            </group>
                            <group>
                                <field name="header_alert" widget="text"/>
                                <field name="header_postit" widget="text"/>
                                <field name="header_options_text" widget="text"/>
                            </group>
                        </group>
                    </div>

                    <!-- Footer Options Section -->
                    <div attrs="{'invisible': [('footer_has_content', '=', False)]}">
                        <separator string="Footer Options"/>
                        <group string="Footer Configuration">
                            <group>
                                <field name="footer_gallery"/>
                                <field name="footer_postit" widget="text"/>
                                <field name="footer_slider"/>
                            </group>
                            <group>
                                <field name="footer_repeat" widget="text"/>
                                <field name="footer_sitemap"/>
                                <field name="footer_options_text" widget="text"/>
                            </group>
                        </group>
                    </div>
                    
                    <!-- Debug view of raw JSON (optional) -->
                    <group string="Debug Information" groups="base.group_no_one">
                        <separator string="Settings (JSON)"/>
                        <field name="settings" widget="json"/>
                        <field name="version" readonly="1"/>
                        <separator string="Options (JSON)"/>
                        <field name="page_options" widget="json"/>
                        <field name="aside_options" widget="json"/>
                        <field name="header_options" widget="json"/>
                        <field name="footer_options" widget="json"/>
                    </group>
                </sheet>
            </form>         
        </field>
    </record>
    
    <record id="view_tree_domainuser" model="ir.ui.view">
        <field name="name">Domain User List</field>
        <field name="model">crearis.domainuser</field>
        <field name="arch" type="xml">
            <tree>
                <field name="cid"/>
                <field name="domain_code"/>
                <field name="role"/>
                <field name="name"/>
                <field name="user_id"/>
                <field name="description"/>
                <field name="is_demo"/>
                <field name="page_has_content"/>
                <field name="aside_has_content"/>
                <field name="header_has_content"/>
                <field name="footer_has_content"/>
                <field name="custom_md"/>
                <field name="active"/>
                <field name="version"/>
            </tree>
        </field>
    </record>
    
    <record id="view_search_domainuser" model="ir.ui.view">
        <field name="name">Domain User Filters</field>
        <field name="model">crearis.domainuser</field>
        <field name="arch" type="xml">
            <search>
                <field name="domain_id"/>
                <field name="domain_code"/>
                <field name="role"/>
                <field name="user_id"/>
                <field name="name"/>
                <field name="cid"/>
                <filter name="filter_inactive"
                        string="Inactive"
                        domain="[('active','=',False)]"/>
                <filter name="filter_active"
                        string="Active"
                        domain="[('active','=',True)]"/>
                <filter name="filter_with_page_options"
                        string="Has Page Options"
                        domain="[('page_has_content','=',True)]"/>
                <filter name="filter_with_header_options"
                        string="Has Header Options"
                        domain="[('header_has_content','=',True)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_domain" string="Domain" context="{'group_by':'domain_id'}"/>
                    <filter name="group_role" string="Role" context="{'group_by':'role'}"/>
                    <filter name="group_user" string="User" context="{'group_by':'user_id'}"/>
                </group>
            </search>
        </field>
    </record>          
</odoo>