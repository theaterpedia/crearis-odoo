<odoo>

    <!-- ========================================================== -->
    <!-- Event Session Line Views (Eleanora's Online Sessions)      -->
    <!-- ========================================================== -->

    <!-- Tree view: All sessions -->
    <record id="view_event_session_line_tree" model="ir.ui.view">
        <field name="name">event.session.line.tree</field>
        <field name="model">event.session.line</field>
        <field name="arch" type="xml">
            <tree string="Event Sessions" 
                  decoration-info="type == 'online'" 
                  decoration-muted="type == 'individual'"
                  default_order="date, start">
                <field name="date"/>
                <field name="day" optional="hide"/>
                <field name="start"/>
                <field name="end"/>
                <field name="duration_h" sum="Total Hours"/>
                <field name="type" widget="badge" 
                       decoration-info="type == 'online'"
                       decoration-success="type == 'venue'"
                       decoration-warning="type == 'individual'"/>
                <field name="event_name"/>
                <field name="address_id" string="Venue"/>
                <field name="location_hint" optional="show"/>
                <field name="conference_url" widget="url" string="Conference" optional="show"/>
                <field name="event_type_id" optional="hide"/>
                <field name="user_id" widget="many2one_avatar_user" optional="hide"/>
            </tree>
        </field>
    </record>

    <!-- Form view: Session details -->
    <record id="view_event_session_line_form" model="ir.ui.view">
        <field name="name">event.session.line.form</field>
        <field name="model">event.session.line</field>
        <field name="arch" type="xml">
            <form string="Event Session">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="display_name" readonly="1"/>
                        </h1>
                    </div>
                    <group col="2">
                        <group string="Event">
                            <field name="event_id"/>
                            <field name="event_type_id" readonly="1"/>
                            <field name="address_id" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                        </group>
                        <group string="Session Time">
                            <field name="date"/>
                            <field name="day"/>
                            <field name="start"/>
                            <field name="end"/>
                            <field name="duration_h"/>
                        </group>
                    </group>
                    <group col="2">
                        <group string="Location">
                            <field name="type"/>
                            <field name="location_hint"/>
                            <field name="room"/>
                        </group>
                        <group string="Conference" attrs="{'invisible': [('type', '!=', 'online')]}">
                            <field name="conference_provider"/>
                            <field name="conference_url" widget="url"/>
                            <field name="conference_id"/>
                            <button name="action_open_conference" 
                                    type="object" 
                                    string="Join Meeting" 
                                    class="btn-primary"
                                    icon="fa-video-camera"
                                    attrs="{'invisible': [('conference_url', '=', False)]}"/>
                        </group>
                    </group>
                    <group string="Notes" attrs="{'invisible': [('notes', '=', False)]}">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search view with filters -->
    <record id="view_event_session_line_search" model="ir.ui.view">
        <field name="name">event.session.line.search</field>
        <field name="model">event.session.line</field>
        <field name="arch" type="xml">
            <search string="Search Sessions">
                <field name="event_name"/>
                <field name="event_id"/>
                <field name="date"/>
                <field name="address_id"/>
                <field name="location_hint"/>
                <separator/>
                
                <!-- Type filters -->
                <filter name="online" string="Online" 
                        domain="[('type', '=', 'online')]"
                        icon="fa-video-camera"/>
                <filter name="venue" string="Venue" 
                        domain="[('type', '=', 'venue')]"
                        icon="fa-building"/>
                <filter name="individual" string="Individual" 
                        domain="[('type', '=', 'individual')]"/>
                <separator/>
                
                <!-- Date filters -->
                <filter name="today" string="Today" 
                        domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="this_week" string="This Week" 
                        domain="[
                            ('date', '&gt;=', (context_today() - datetime.timedelta(days=context_today().weekday())).strftime('%Y-%m-%d')),
                            ('date', '&lt;', (context_today() + datetime.timedelta(days=7-context_today().weekday())).strftime('%Y-%m-%d'))
                        ]"/>
                <filter name="next_30_days" string="Next 30 Days" 
                        domain="[
                            ('date', '&gt;=', context_today().strftime('%Y-%m-%d')),
                            ('date', '&lt;', (context_today() + datetime.timedelta(days=30)).strftime('%Y-%m-%d'))
                        ]"/>
                <filter name="next_90_days" string="Next 90 Days" 
                        domain="[
                            ('date', '&gt;=', context_today().strftime('%Y-%m-%d')),
                            ('date', '&lt;', (context_today() + datetime.timedelta(days=90)).strftime('%Y-%m-%d'))
                        ]"/>
                <separator/>
                
                <!-- Conference status -->
                <filter name="has_conference" string="Has Conference Link" 
                        domain="[('conference_url', '!=', False)]"/>
                <filter name="no_conference" string="No Conference Link" 
                        domain="[('conference_url', '=', False), ('type', '=', 'online')]"/>
                <separator/>
                
                <!-- Group By -->
                <group expand="1" string="Group By">
                    <filter name="group_date" string="Date" 
                            context="{'group_by': 'date'}"/>
                    <filter name="group_week" string="Week" 
                            context="{'group_by': 'date:week'}"/>
                    <filter name="group_month" string="Month" 
                            context="{'group_by': 'date:month'}"/>
                    <separator/>
                    <filter name="group_type" string="Type" 
                            context="{'group_by': 'type'}"/>
                    <filter name="group_event" string="Event" 
                            context="{'group_by': 'event_id'}"/>
                    <filter name="group_venue" string="Venue" 
                            context="{'group_by': 'address_id'}"/>
                    <filter name="group_event_type" string="Event Type" 
                            context="{'group_by': 'event_type_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Calendar view for session planning -->
    <record id="view_event_session_line_calendar" model="ir.ui.view">
        <field name="name">event.session.line.calendar</field>
        <field name="model">event.session.line</field>
        <field name="arch" type="xml">
            <calendar string="Sessions Calendar" 
                      date_start="date" 
                      color="type"
                      quick_add="False"
                      event_open_popup="True">
                <field name="event_name"/>
                <field name="start"/>
                <field name="end"/>
                <field name="type"/>
                <field name="location_hint"/>
            </calendar>
        </field>
    </record>

    <!-- ========================================================== -->
    <!-- Actions                                                     -->
    <!-- ========================================================== -->

    <!-- Action: All Online Sessions (Eleanora's primary view) -->
    <record id="action_online_session_lines" model="ir.actions.act_window">
        <field name="name">Online Sessions</field>
        <field name="res_model">event.session.line</field>
        <field name="view_mode">tree,calendar,form</field>
        <field name="domain">[('type', '=', 'online')]</field>
        <field name="context">{
            'search_default_next_30_days': 1,
        }</field>
        <field name="search_view_id" ref="view_event_session_line_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No online sessions found!
            </p>
            <p>
                Online sessions are parsed from event schedule text containing 
                <code>_online_</code> markers.
            </p>
        </field>
    </record>

    <!-- Action: All Sessions -->
    <record id="action_all_session_lines" model="ir.actions.act_window">
        <field name="name">All Sessions</field>
        <field name="res_model">event.session.line</field>
        <field name="view_mode">tree,calendar,form</field>
        <field name="context">{
            'search_default_next_30_days': 1,
        }</field>
        <field name="search_view_id" ref="view_event_session_line_search"/>
    </record>

    <!-- Action: Sessions by Venue (Eleanora's booking overview) -->
    <record id="action_session_lines_by_venue" model="ir.actions.act_window">
        <field name="name">Sessions by Venue</field>
        <field name="res_model">event.session.line</field>
        <field name="view_mode">tree,calendar,form</field>
        <field name="domain">[('type', '=', 'venue')]</field>
        <field name="context">{
            'search_default_next_90_days': 1,
            'search_default_group_venue': 1,
        }</field>
        <field name="search_view_id" ref="view_event_session_line_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No venue sessions found!
            </p>
            <p>
                Group by venue to see booking overview for location partners.
            </p>
        </field>
    </record>

    <!-- ========================================================== -->
    <!-- Menus                                                       -->
    <!-- ========================================================== -->

    <!-- Menu: Events → Sessions submenu -->
    <menuitem id="menu_event_sessions_root"
              name="Sessions"
              parent="event.event_main_menu"
              sequence="15"/>
    
    <menuitem id="menu_online_session_lines"
              name="Online Sessions"
              parent="menu_event_sessions_root"
              action="action_online_session_lines"
              sequence="10"/>
    
    <menuitem id="menu_session_lines_by_venue"
              name="By Venue"
              parent="menu_event_sessions_root"
              action="action_session_lines_by_venue"
              sequence="20"/>
    
    <menuitem id="menu_all_session_lines"
              name="All Sessions"
              parent="menu_event_sessions_root"
              action="action_all_session_lines"
              sequence="30"/>

</odoo>
