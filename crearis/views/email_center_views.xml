<!--  D90.2: Email-Center hub menu -->
<odoo>

    <!-- ========================================= -->
    <!-- Email-Center: Parent Menu                 -->
    <!-- ========================================= -->
    <menuitem id="menu_email_center" 
              name="Email-Center" 
              parent="menu_crearis" 
              sequence="15"/>

    <!-- ========================================= -->
    <!-- Email-Vorlagen (mail.template filtered)   -->
    <!-- ========================================= -->
    <record id="action_mail_template_crearis" model="ir.actions.act_window">
        <field name="name">Email-Vorlagen</field>
        <field name="res_model">mail.template</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="domain">[('model_id.model', 'in', ['calendar.event', 'event.registration', 'crm.lead', 'event.event'])]</field>
        <field name="context">{'search_default_model_id': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Keine Email-Vorlagen gefunden
            </p>
            <p>
                Email-Vorlagen für Beratungen, Event-Registrierungen und Leads.
            </p>
        </field>
    </record>

    <!-- Mail Template: Kanban View -->
    <record id="view_mail_template_kanban_crearis" model="ir.ui.view">
        <field name="name">mail.template.kanban.crearis</field>
        <field name="model">mail.template</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="model"/>
                <field name="subject"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top mb-1">
                                    <span class="badge bg-secondary me-1" t-esc="record.model.raw_value"/>
                                </div>
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div class="text-muted text-truncate">
                                    <field name="subject"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <menuitem id="menu_mail_template_crearis" 
              name="Email-Vorlagen" 
              parent="menu_email_center" 
              action="action_mail_template_crearis"
              sequence="10"/>

    <!-- ========================================= -->
    <!-- Email Snippets (moved from Settings)      -->
    <!-- ========================================= -->
    <menuitem id="menu_mail_snippet" 
              name="Email Snippets" 
              parent="menu_email_center" 
              action="action_mail_snippet"
              sequence="20"/>

    <!-- ========================================= -->
    <!-- PDF Reports (ir.actions.report filtered)  -->
    <!-- ========================================= -->
    <record id="action_report_crearis" model="ir.actions.act_window">
        <field name="name">PDF Reports</field>
        <field name="res_model">ir.actions.report</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('model', 'in', ['event.registration', 'event.event', 'calendar.event'])]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Keine PDF Reports gefunden
            </p>
            <p>
                PDF Reports für Events und Registrierungen.
            </p>
        </field>
    </record>

    <menuitem id="menu_report_crearis" 
              name="PDF Reports" 
              parent="menu_email_center" 
              action="action_report_crearis"
              sequence="30"/>

</odoo>
