<odoo>
  <data>
    <!-- Crearis Domain Sync -->
    <record id="crearis_sync_domain" model="res.groups">
      <field name="name">Sync-User</field>
      <field name="category_id"
             ref="base.module_category_website_crearis"/>       
    </record>

    <!-- Crearis Domain Users -->
    <record id="crearis_use_domain" model="res.groups">
      <field name="name">User</field>
      <field name="category_id"
             ref="base.module_category_website_crearis"/>      
      <field name="implied_ids"
             eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Crearis Domain Managers -->
    <record id="crearis_manage_domain" model="res.groups">
      <field name="name">Manager</field>
      <field name="category_id"
             ref="base.module_category_website_crearis"/>        
      <field name="implied_ids"
             eval="[(4, ref('crearis_sync_domain'))]"/>
    </record>

    <!-- Checkout Manager: receives manual-review checkout notifications -->
    <record id="group_checkout_manager" model="res.groups">
      <field name="name">Checkout Manager</field>
      <field name="category_id"
             ref="base.module_category_website_crearis"/>
      <field name="implied_ids"
             eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Event Type Company Rule: Only show event types for current company or global (no company) -->
    <record id="event_type_company_rule" model="ir.rule">
      <field name="name">Event Type: Company Filter</field>
      <field name="model_id" ref="event.model_event_type"/>
      <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
      <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
  </data>
</odoo>