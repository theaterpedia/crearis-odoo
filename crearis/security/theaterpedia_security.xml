<odoo>
  <data>
    <!-- Crearis Domain Sync -->
    <record id="crearis_sync_domain" model="res.groups">
      <field name="name">Sync-User</field>
      <field name="category_id"
             ref="base.module_category_website_crearis"/>       
    </record>

    <!-- Crearis Domain Users -->
    <record id="crearis_use_domain" model="res.groups">
      <field name="name">User</field>
      <field name="category_id"
             ref="base.module_category_website_crearis"/>      
      <field name="implied_ids"
             eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Crearis Domain Managers -->
    <record id="crearis_manage_domain" model="res.groups">
      <field name="name">Manager</field>
      <field name="category_id"
             ref="base.module_category_website_crearis"/>        
      <field name="implied_ids"
             eval="[(4, ref('crearis_sync_domain'))]"/>
    </record>

    <!-- Event Type Company Rule: Only show event types for current company or global (no company) -->
    <record id="event_type_company_rule" model="ir.rule">
      <field name="name">Event Type: Company Filter</field>
      <field name="model_id" ref="event.model_event_type"/>
      <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
      <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Layer 1 (DA): Domain isolation for partners - Manager rule (full access) -->
    <record id="partner_domain_origin_manager_rule" model="ir.rule">
      <field name="name">Partner: Domain Origin (Manager)</field>
      <field name="model_id" ref="base.model_res_partner"/>
      <field name="domain_force">[(1, '=', 1)]</field>
      <field name="groups" eval="[(4, ref('crearis_manage_domain'))]"/>
    </record>

    <!-- Layer 1 (DA): Domain isolation for partners - User rule (own domain only) -->
    <!-- Note: For now allows legacy (NULL) only. Full domainuser-based check requires compute field -->
    <record id="partner_domain_origin_user_rule" model="ir.rule">
      <field name="name">Partner: Domain Origin (User)</field>
      <field name="model_id" ref="base.model_res_partner"/>
      <field name="domain_force">[('origin_domain_code', '=', False)]</field>
      <field name="groups" eval="[(4, ref('crearis_use_domain'))]"/>
    </record>
  </data>
</odoo>