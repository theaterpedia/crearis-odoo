<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Override: Event Reminder Template (3 days before)
            
            Changes from base event.event_reminder:
            1. German translation
            2. Event title in separate block with overline-headline format
            3. Session times from agenda_line_ids (not event date_begin/date_end)
            
            See: 2026-03-16 email template improvement task
        -->
        <record id="event.event_reminder" model="mail.template">
            <field name="name">Event: Reminder (DE)</field>
            <field name="subject">{{ object.event_id.name }}: {{ object.get_date_range_str() }}</field>
            <field name="description">Erinnerung an Teilnehmer (konfigurierbar pro Event-Typ, z.B. 3 Tage vorher)</field>
            <field name="body_html" type="html">
<table border="0" cellpadding="0" cellspacing="0" style="padding-top: 16px; background-color: #F1F1F1; font-family:Verdana, Arial,sans-serif; color: #454748; width: 100%; border-collapse:separate;"><tr><td align="center">
<t t-set="title_parts" t-value="object.get_event_title_parts()"/>
<t t-set="is_online" t-value="'is_published' in object.event_id and object.event_id.is_published"/>
<t t-set="event_organizer" t-value="object.event_id.organizer_id"/>
<t t-set="event_address" t-value="object.event_id.address_id"/>
<t t-set="session_schedule" t-value="object.get_session_schedule_html()"/>
<table border="0" cellpadding="0" cellspacing="0" width="590" style="padding: 16px; background-color: white; color: #454748; border-collapse:separate;">
<tbody>
    <!-- HEADER -->
    <tr>
        <td align="center" style="min-width: 590px;">
            <table width="590" border="0" cellpadding="0" cellspacing="0" style="min-width: 590px; background-color: white; padding: 0px 8px 0px 8px; border-collapse:separate;">
                <tr><td valign="middle">
                    <span style="font-size: 10px;">Deine Anmeldung</span><br/>
                    <span style="font-size: 20px; font-weight: bold;" t-out="object.name or ''">Max Mustermann</span>
                </td><td valign="middle" align="right">
                    <t t-if="is_online">
                        <a t-attf-href="{{ object.event_id.website_url }}"
                            style="padding: 8px 12px; font-size: 12px; color: #FFFFFF; text-decoration: none !important; font-weight: 400; background-color: #875A7B; border: 0px solid #875A7B; border-radius:3px">
                            Zur Veranstaltung
                        </a>
                    </t>
                    <t t-else="">
                        <img t-att-src="'/logo.png?company=%s' % object.company_id.id" style="padding: 0px; margin: 0px; height: auto; width: 80px;" t-att-alt="'%s' % object.company_id.name"/>
                    </t>
                </td></tr>
                <tr><td colspan="2" style="text-align:center;">
                  <hr width="100%" style="background-color:rgb(204,204,204);border:medium none;clear:both;display:block;font-size:0px;min-height:1px;line-height:0; margin:16px 0px 16px 0px;"/>
                </td></tr>
            </table>
        </td>
    </tr>

    <!-- EVENT TITLE BLOCK (overline-headline) -->
    <tr>
        <td align="center" style="min-width: 590px;">
            <table width="590" border="0" cellpadding="0" cellspacing="0" style="min-width: 590px; background-color: #f8f9fa; padding: 20px; border-radius: 8px; margin: 0 8px 20px 8px; border-collapse:separate;">
                <tr><td>
                    <!-- Overline: Event Type -->
                    <t t-if="title_parts.get('overline')">
                        <div style="color: #888; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px;">
                            <t t-out="title_parts.get('overline')"/>
                        </div>
                    </t>
                    <!-- Subline (text before **) -->
                    <t t-if="title_parts.get('subline')">
                        <div style="font-size: 14px; color: #666; margin-top: 4px;">
                            <t t-out="title_parts.get('subline')"/>
                        </div>
                    </t>
                    <!-- Headline (text in **) -->
                    <div style="font-size: 20px; font-weight: bold; margin-top: 5px; color: #333;">
                        <t t-out="title_parts.get('headline')"/>
                    </div>
                </td></tr>
            </table>
        </td>
    </tr>

    <!-- EVENT DESCRIPTION -->
    <tr>
        <td align="center" style="min-width: 590px;">
            <table width="590" border="0" cellpadding="0" cellspacing="0" style="min-width: 590px; background-color: white; padding: 0px 8px 0px 8px; border-collapse:separate;">
                <tr><td valign="top" style="font-size: 14px;">
                    <div>
                        Hallo <t t-out="object.name or ''">Max Mustermann</t>,<br/>
                        wir freuen uns, dich daran zu erinnern, dass die Veranstaltung
                        <strong t-out="object.get_date_range_str() or ''">in 3 Tagen</strong> beginnt.
                    </div>
                    <div>
                        <br />
                        <strong>Zum Kalender hinzufügen</strong>
                        <t t-set="date_begin" t-value="format_datetime(object.event_id.date_begin, tz='UTC', dt_format=&quot;yyyyMMdd'T'HHmmss'Z'&quot;)"/>
                        <t t-set="date_end" t-value="format_datetime(object.event_id.date_end, tz='UTC', dt_format=&quot;yyyyMMdd'T'HHmmss'Z'&quot;)"/>
                        <t t-set="location" t-value="event_address.street if event_address else ''"/>
                        <a t-attf-href="https://www.google.com/calendar/render?action=TEMPLATE&amp;text={{ object.event_id.name }}&amp;dates={{ date_begin }}/{{ date_end }}&amp;location={{ location }}" style="padding:3px 5px;border:1px solid #875A7B;color:#875A7B;text-decoration:none;border-radius:3px;" target="new"><img src="/web_editor/font_to_img/61525/rgb(135,90,123)/16" style="vertical-align:middle;" height="16" alt=""/> Google</a>
                        <a t-attf-href="/event/{{ slug(object.event_id) }}/ics" style="padding:3px 5px;border:1px solid #875A7B;color:#875A7B;text-decoration:none;border-radius:3px;"><img src="/web_editor/font_to_img/61525/rgb(135,90,123)/16" style="vertical-align:middle;" height="16" alt=""/> iCal/Outlook</a>
                        <br /><br />
                    </div>
                    <div>
                        Wir freuen uns auf dich!<br/>
                        <span style="color: #454748;">
                        -- <br/>
                        <t t-if="event_organizer">
                            <t t-out="event_organizer.name or ''">DAS Ei e.V.</t>
                        </t>
                        <t t-else="">
                            Das <t t-out="object.event_id.name or ''">Veranstaltungs</t>-Team
                        </t>
                        </span>
                    </div>
                </td></tr>
                <tr><td style="text-align:center;">
                  <hr width="100%" style="background-color:rgb(204,204,204);border:medium none;clear:both;display:block;font-size:0px;min-height:1px;line-height:0; margin: 16px 0px 16px 0px;"/>
                </td></tr>
            </table>
        </td>
    </tr>

    <!-- SCHEDULE DETAILS (from agenda_line_ids) -->
    <tr>
        <td align="center" style="min-width: 590px;">
            <table width="590" border="0" cellpadding="0" cellspacing="0" style="min-width: 590px; background-color: white; padding: 0px 8px 0px 8px; border-collapse:separate;">
                <tr><td valign="top" style="font-size: 14px;">
                    <table style="width:100%;">
                        <tr>
                            <!-- Session schedule (from agenda lines) -->
                            <td style="vertical-align:top; width: 50%;">
                                <img src="/web_editor/font_to_img/61555/rgb(81,81,102)/34" style="padding:4px;max-width:inherit;" height="34" alt=""/>
                                <div style="padding: 0px 10px; line-height: 20px;">
                                    <strong>Zeiten</strong>
                                    <t t-if="session_schedule">
                                        <t t-out="session_schedule"/>
                                    </t>
                                    <t t-else="">
                                        <!-- Fallback to event dates if no sessions -->
                                        <div><strong>Von</strong> <t t-out="object.event_id.date_begin_located or ''">19.03.2026, 08:00</t></div>
                                        <div><strong>Bis</strong> <t t-out="object.event_id.date_end_located or ''">22.03.2026, 17:00</t></div>
                                        <div style="font-size:12px;color:#9e9e9e"><i><t t-out="object.event_id.date_tz or ''">Europe/Berlin</t></i></div>
                                    </t>
                                </div>
                            </td>
                            <!-- Location -->
                            <td style="vertical-align:top; width: 50%;">
                                <t t-if="event_address">
                                    <img src="/web_editor/font_to_img/61505/rgb(81,81,102)/34" style="padding:4px;max-width:inherit;" height="34" alt=""/>
                                    <div style="padding: 0px 10px;">
                                        <strong>Ort</strong>
                                        <t t-set="location" t-value="''"/>
                                        <t t-if="object.event_id.address_id.name">
                                            <div t-out="object.event_id.address_id.name or ''">Burgstallmühle</div>
                                        </t>
                                        <t t-if="object.event_id.address_id.street">
                                            <div t-out="object.event_id.address_id.street or ''">Burgstallmühle 1</div>
                                            <t t-set="location" t-value="object.event_id.address_id.street"/>
                                        </t>
                                        <t t-if="object.event_id.address_id.street2">
                                            <div t-out="object.event_id.address_id.street2 or ''">Voggendorf</div>
                                            <t t-set="location" t-value="'%s, %s' % (location, object.event_id.address_id.street2)"/>
                                        </t>
                                        <div>
                                        <t t-if="object.event_id.address_id.city">
                                            <t t-out="object.event_id.address_id.city or ''">Bechhofen</t>
                                            <t t-set="location" t-value="'%s, %s' % (location, object.event_id.address_id.city)"/>
                                        </t>
                                        <t t-if="object.event_id.address_id.zip">
                                            <t t-out="object.event_id.address_id.zip or ''">91572</t>
                                            <t t-set="location" t-value="'%s, %s' % (location, object.event_id.address_id.zip)"/>
                                        </t>
                                        </div>
                                    </div>
                                </t>
                            </td>
                        </tr>
                    </table>
                </td></tr>
                <tr><td style="text-align:center;">
                    <t t-if="event_organizer">
                        <hr width="100%" style="background-color:rgb(204,204,204);border:medium none;clear:both;display:block;font-size:0px;min-height:1px;line-height:0; margin: 16px 0px 16px 0px;"/>
                    </t>
                </td></tr>

                <!-- CONTACT ORGANIZER -->
                <tr><td valign="top" style="font-size: 14px;">
                    <t t-if="event_organizer">
                        <div>
                            <span style="font-weight:300;margin:10px 0">Fragen zur Veranstaltung?</span>
                            <div>Kontaktiere den Veranstalter:</div>
                            <ul>
                                <li><t t-out="event_organizer.name or ''">DAS Ei e.V.</t></li>
                                <t t-if="event_organizer.email">
                                    <li>E-Mail: <a t-attf-href="mailto:{{ event_organizer.email }}" style="text-decoration:none;color:#875A7B;" t-out="event_organizer.email or ''">info@dasei.eu</a></li>
                                </t>
                                <t t-if="event_organizer.phone">
                                    <li>Telefon: <t t-out="event_organizer.phone or ''">+49 911 7808476</t></li>
                                </t>
                            </ul>
                        </div>
                    </t>
                </td></tr>
                <tr><td style="text-align:center;">
                    <t t-if="is_online or event_address">
                        <hr width="100%" style="background-color:rgb(204,204,204);border:medium none;clear:both;display:block;font-size:0px;min-height:1px;line-height:0; margin: 16px 0px 16px 0px;"/>
                    </t>
                </td></tr>

                <!-- GOOGLE MAPS LINK -->
                <tr><td valign="top" style="font-size: 14px;">
                    <t t-if="event_address and location">
                        <table style="width:100%;"><tr><td>
                            <div>
                                <i class="fa fa-map-marker"/>
                                <a t-attf-href="https://maps.google.com/maps?q={{ location }}" target="new">
                                    Standort auf Google Maps anzeigen
                                </a>
                            </div>
                        </td></tr></table>
                    </t>
                </td></tr>
            </table>
        </td>
    </tr>
</tbody>
</table>
</td></tr>
<!-- FOOTER -->
<tr><td align="center" style="min-width: 590px;">
    <t t-if="object.company_id">
        <table width="590" border="0" cellpadding="0" cellspacing="0" style="min-width: 590px; background-color: #F1F1F1; color: #454748; padding: 8px; border-collapse:separate;">
        <tr><td style="text-align: center; font-size: 14px;">
            Gesendet von <a target="_blank" t-attf-href="{{ object.company_id.website }}" style="color: #875A7B;" t-out="object.company_id.name or ''">DAS Ei e.V.</a>
            <t t-if="is_online">
                <br />
                Entdecke <a href="/event" style="color:#875A7B;">alle unsere Veranstaltungen</a>.
            </t>
        </td></tr>
        </table>
    </t>
</td></tr>
</table>
            </field>
            <field name="lang">{{ object.partner_id.lang }}</field>
        </record>

    </data>
</odoo>
