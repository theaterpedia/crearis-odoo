<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Consulting event types for per-domain booking (availability window approach).
            
            - Consulting Window: Exec defines availability blocks (e.g., Mon 9-12 recurring)
            - Consulting Meeting: System creates when customer books a 15-min slot
            
            Session: SCS (03-02-SCS_consulting_slots)
        -->
        <record id="calendar_event_type_consulting_window" model="calendar.event.type">
            <field name="name">Consulting Window</field>
        </record>
        <record id="calendar_event_type_consulting_meeting" model="calendar.event.type">
            <field name="name">Consulting Meeting</field>
        </record>
        <record id="calendar_event_type_consulting_blocked" model="calendar.event.type">
            <field name="name">Consulting Blocked</field>
        </record>

        <!--
            Consultation category types (SCL - Consulting Loop).
            
            Used to tag calendar.event meetings with topics the customer selected.
            Stored via categ_ids M2M field. GraphQL receives string keys, maps to these.
            
            Order matches D24 (envelope template ordering):
            1. prerequisites
            2. terms_and_options
            3. topics
            4. schedules
            5. custom (freeform)
        -->
        <record id="calendar_event_type_cat_prerequisites" model="calendar.event.type">
            <field name="name">Consultation: Prerequisites</field>
        </record>
        <record id="calendar_event_type_cat_terms_and_options" model="calendar.event.type">
            <field name="name">Consultation: Terms &amp; Options</field>
        </record>
        <record id="calendar_event_type_cat_topics" model="calendar.event.type">
            <field name="name">Consultation: Topics</field>
        </record>
        <record id="calendar_event_type_cat_schedules" model="calendar.event.type">
            <field name="name">Consultation: Schedules</field>
        </record>
        <record id="calendar_event_type_cat_custom" model="calendar.event.type">
            <field name="name">Consultation: Custom</field>
        </record>
    </data>
</odoo>
