<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Customer confirmation email for consulting slot booking -->
        <record id="mail_template_consulting_booking_customer" model="mail.template">
            <field name="name">Consulting Booking: Customer Confirmation</field>
            <field name="model_id" ref="calendar.model_calendar_event"/>
            <field name="subject">Fragen &amp; Antworten mit {{ object.user_id.name }} - {{ format_datetime(dt=object.start, tz='Europe/Berlin', dt_format='dd.MM.yyyy HH:mm') }}</field>
            <field name="email_from">{{ (object.user_id.email_formatted or object.user_id.company_id.email_formatted or 'noreply@dasei.eu') }}</field>
            <field name="email_to">{{ object.partner_ids[:1].email }}</field>
            <field name="body_html"><![CDATA[
<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
    
    <p>Hallo <strong><t t-out="object.partner_ids[:1].name.split()[0] if object.partner_ids[:1].name else ''"/></strong>,</p>
    
    <p>schön, dass du dich gemeldet hast! Hier sind die Details zu unserem Gespräch:</p>
    
    <!-- Product/Course header -->
    <t t-set="product_info" t-value="object.get_product_info()"/>
    <t t-if="product_info and product_info.get('shortcode')">
    <div style="background: #f8f9fa; padding: 20px; border-radius: 8px; margin: 20px 0 7px 0;">
        <div style="color: #888; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px;"><t t-out="product_info.get('type_label')"/> <t t-out="product_info.get('shortcode')"/></div>
        <div style="font-size: 20px; font-weight: bold; margin: 5px 0 0 0;"><t t-out="product_info.get('headline')"/></div>
    </div>
    </t>
    
    <div style="background: #f8f9fa; padding: 20px; border-radius: 8px; margin: 20px 0;">
        <div style="color: #888; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px;">Fragen &amp; Antworten mit</div>
        <div style="font-size: 16px; font-weight: bold; margin: 5px 0 0 0;"><t t-out="object.user_id.name"/>: <t t-out="format_datetime(object.start, tz='Europe/Berlin', dt_format='EE', lang_code='de_DE').upper()"/>, <t t-out="format_datetime(object.start, tz='Europe/Berlin', dt_format='d. MMMM', lang_code='de_DE')"/> um <t t-out="format_datetime(object.start, tz='Europe/Berlin', dt_format='HH:mm', lang_code='de_DE')"/></div>
        
        <!-- Video call info directly in header -->
        <t t-if="object.videocall_location">
        <div style="margin-top: 15px; padding-top: 15px; border-top: 1px solid #ddd;">
            <div style="color: #888; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px;">Video-Call</div>
            <div style="margin-top: 5px;">
                <a t-att-href="object.videocall_location" style="color: #0066cc; text-decoration: none;">
                    <t t-out="'🎥 Zum Meeting beitreten'"/>
                </a>
            </div>
            <t t-set="teams_data" t-value="object.get_consulting_option('teams_meeting_data', default={}) or {}"/>
            <t t-if="teams_data.get('videocall_id')">
            <div style="color: #666; font-size: 13px; margin-top: 5px;">Besprechungs-ID: <t t-out="teams_data.get('videocall_id')"/></div>
            </t>
            <t t-if="teams_data.get('phonecall_id')">
            <div style="color: #666; font-size: 13px; margin-top: 8px;">falls Video nicht klappt einfach per Telefon einwählen:<br/>tel:<t t-out="teams_data.get('phonecall_id')"/></div>
            <t t-if="teams_data.get('phonecall_conference_id')">
            <div style="color: #666; font-size: 13px;">Telefonkonferenz-ID: <t t-out="teams_data.get('phonecall_conference_id')"/></div>
            </t>
            </t>
        </div>
        </t>
    </div>
    
    <!-- Schwerpunkte section - iterate over selections list -->
    <t t-set="selections" t-value="object.get_consulting_option('selections', default=[]) or []"/>
    <t t-if="selections">
    <div style="margin: 20px 0;">
        <div style="color: #555;"><strong>Schwerpunkte:</strong></div>
        <t t-foreach="selections" t-as="sel">
        <t t-if="sel.get('options') or sel.get('text')">
        <div style="color: #555; margin: 4px 0;">
            - <t t-out="sel.get('label', sel.get('key', ''))"/>: 
            <t t-if="sel.get('options')">
                <t t-foreach="sel.get('options', [])" t-as="opt">
                    <t t-if="opt_index > 0">, </t>
                    <!-- 2026-03-13: Support URL-enabled options from CN -->
                    <t t-if="isinstance(opt, dict) and opt.get('url')">
                        <a t-att-href="'https://dasei.eu' + opt.get('url')" style="color: #0066cc;"><t t-out="opt.get('label', opt)"/></a>
                    </t>
                    <t t-elif="isinstance(opt, dict)">
                        <t t-out="opt.get('label', str(opt))"/>
                    </t>
                    <t t-else="">
                        <t t-out="opt"/>
                    </t>
                </t>
            </t>
            <t t-if="sel.get('text')"> [<t t-out="sel.get('text')"/>]</t>
        </div>
        </t>
        </t>
    </div>
    </t>
    
    <p style="margin-top: 20px;"><strong>Bis bald!</strong></p>
    
    <p style="color: #666; font-size: 14px;">PS: Du darfst gerne einfach auf diese Email antworten 😊</p>
    
    <!-- SCL: QWeb schedules snippet - company-customizable event resolution -->
    <!-- Step 1: Read JSONB config (generic) -->
    <t t-set="schedule" t-value="object.get_consulting_option('schedule', default={}) or {}"/>
    <t t-set="slugs" t-value="schedule.get('product_slugs', []) if schedule else []"/>
    <t t-set="city" t-value="schedule.get('city', '') if schedule else ''"/>
    <t t-set="city_exclude" t-value="schedule.get('city_exclude', False) if schedule else False"/>
    
    <!-- Step 2: Product → Event Type (company-specific - uses crearis_event_package) -->
    <t t-set="products" t-value="env['product.product'].sudo().search([('default_code', 'in', slugs)])"/>
    <t t-set="type_ids" t-value="sum([p.product_tmpl_id.get_linked_event_type_ids() for p in products if hasattr(p.product_tmpl_id, 'get_linked_event_type_ids')], [])"/>
    
    <!-- Step 3: Search events (generic helper) -->
    <t t-set="events" t-value="object.search_upcoming_events(type_ids, city, city_exclude, 5)"/>
    
    <t t-if="events">
    <hr style="border: none; border-top: 1px solid #eee; margin: 20px 0;"/>
    <div style="margin: 20px 0;">
        <!-- Category overline header like website -->
        <div style="color: #c17a00; font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 2px;">Termine &amp; Zeitplanung</div>
        <div style="font-size: 18px; font-weight: bold; margin-bottom: 15px;">Verläufe</div>
        <table style="width: 100%; border-collapse: collapse;">
            <t t-foreach="events" t-as="ev">
            <t t-set="ev_name" t-value="(ev.name.get('de_DE') or ev.name.get('en_US') or str(ev.name)) if isinstance(ev.name, dict) else str(ev.name)"/>
            <!-- Parse name: "Overline **Headline**" pattern -->
            <t t-set="has_headline" t-value="'**' in ev_name"/>
            <t t-set="overline_part" t-value="ev_name.split('**')[0].strip() if has_headline else ''"/>
            <t t-set="headline_part" t-value="ev_name.split('**')[1].strip() if has_headline and len(ev_name.split('**')) > 1 else ev_name.replace('**', '')"/>
            <!-- Get template code if is_template_code=True -->
            <t t-set="type_name_raw" t-value="ev.event_type_id.name if ev.event_type_id else {}"/>
            <t t-set="type_code" t-value="(type_name_raw.get('en_US') or type_name_raw.get('de_DE') or '') if isinstance(type_name_raw, dict) else str(type_name_raw or '')"/>
            <t t-set="show_code" t-value="ev.event_type_id and ev.event_type_id.is_template_code and type_code"/>
            <!-- Date range formatting -->
            <t t-set="start_date" t-value="ev.date_begin"/>
            <t t-set="end_date" t-value="ev.date_end"/>
            <t t-set="same_day" t-value="start_date.date() == end_date.date() if start_date and end_date else True"/>
            <t t-set="weekdays" t-value="['MO', 'DI', 'MI', 'DO', 'FR', 'SA', 'SO']"/>
            <tr>
                <td style="padding: 8px 0; border-bottom: 1px solid #eee; vertical-align: top; width: 65%;">
                    <t t-if="show_code"><span style="color: #888; font-size: 11px; text-transform: uppercase;"><t t-out="type_code"/></span> </t><t t-if="overline_part"><span style="color: #555; font-size: 13px;"><t t-out="overline_part"/></span><br/></t>
                    <strong><t t-out="headline_part"/></strong>
                </td>
                <td style="padding: 8px 0; border-bottom: 1px solid #eee; vertical-align: top; text-align: right;">
                    <t t-if="same_day">
                    <t t-out="start_date.strftime('%d.%m.%Y') if start_date else ''"/> <t t-out="start_date.strftime('%H:%M') if start_date and start_date.hour != 7 else '09:00'"/><br/>
                    </t>
                    <t t-if="not same_day">
                    <t t-out="start_date.strftime('%d.')"/>-<t t-out="end_date.strftime('%d.%m.%Y')"/><br/>
                    <span style="font-size: 12px;">(<t t-out="weekdays[start_date.weekday()]"/> <t t-out="start_date.strftime('%H:%M') if start_date.hour != 7 else '18:00'"/> - <t t-out="weekdays[end_date.weekday()]"/> <t t-out="end_date.strftime('%H:%M') if end_date.hour != 7 else '15:00'"/>)</span><br/>
                    </t>
                    <t t-if="ev.address_id and ev.address_id.city"><span style="color: #666;"><t t-out="ev.address_id.city"/></span></t>
                </td>
            </tr>
            </t>
        </table>
    </div>
    </t>
    
    <hr style="border: none; border-top: 1px solid #eee; margin: 30px 0;"/>
    <p style="color: #888; font-size: 12px; text-align: center;">
        powered by <a href="https://theaterpedia.org" style="color: #888;">Theaterpedia</a>
    </p>
</div>
]]></field>
            <field name="lang">{{ object.partner_ids[:1].lang }}</field>
            <field name="auto_delete" eval="True"/>
        </record>

        <!-- Exec notification email for consulting slot booking -->
        <record id="mail_template_consulting_booking_exec" model="mail.template">
            <field name="name">Consulting Booking: Exec Notification</field>
            <field name="model_id" ref="calendar.model_calendar_event"/>
            <field name="subject">Neuer Beratungstermin: {{ object.partner_ids[:1].name }} - {{ format_datetime(dt=object.start, tz='Europe/Berlin', dt_format='dd.MM.yyyy HH:mm') }}</field>
            <field name="email_from">{{ object.user_id.company_id.email_formatted or 'noreply@dasei.eu' }}</field>
            <field name="email_to">{{ object.user_id.email }}</field>
            <field name="body_html"><![CDATA[
<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
    
    <t t-set="partner" t-value="object.partner_ids[:1]"/>
    <t t-set="partner_firstname" t-value="partner.firstname if hasattr(partner, 'firstname') and partner.firstname else (partner.name.split()[0] if partner.name else '')"/>
    <t t-set="exec_firstname" t-value="object.user_id.partner_id.firstname if hasattr(object.user_id.partner_id, 'firstname') and object.user_id.partner_id.firstname else (object.user_id.name.split()[0] if object.user_id.name else '')"/>
    
    <p>Hallo <strong><t t-out="exec_firstname"/></strong>,</p>
    
    <p>du hast eine neue Beratung mit: <strong><t t-out="partner.name"/></strong></p>
    
    <table style="width: 100%; border-collapse: collapse; margin: 20px 0; background: #f8f9fa;">
        <tr>
            <td style="padding: 12px; border-bottom: 1px solid #ddd; width: 30%;"><strong>E-Mail:</strong></td>
            <td style="padding: 12px; border-bottom: 1px solid #ddd;"><t t-out="partner.email"/></td>
        </tr>
        <t t-if="partner.phone or partner.mobile">
        <tr>
            <td style="padding: 12px; border-bottom: 1px solid #ddd;"><strong>Telefon:</strong></td>
            <td style="padding: 12px; border-bottom: 1px solid #ddd;"><t t-out="partner.phone or partner.mobile"/></td>
        </tr>
        </t>
        <tr>
            <td style="padding: 12px; border-bottom: 1px solid #ddd;"><strong>Datum:</strong></td>
            <td style="padding: 12px; border-bottom: 1px solid #ddd;"><t t-out="format_datetime(object.start, tz='Europe/Berlin', dt_format='EEEE, d. MMMM y', lang_code='de_DE')"/></td>
        </tr>
        <tr>
            <td style="padding: 12px; border-bottom: 1px solid #ddd;"><strong>Uhrzeit:</strong></td>
            <td style="padding: 12px; border-bottom: 1px solid #ddd;"><t t-out="format_datetime(object.start, tz='Europe/Berlin', dt_format='HH:mm', lang_code='de_DE')"/> - <t t-out="format_datetime(object.stop, tz='Europe/Berlin', dt_format='HH:mm', lang_code='de_DE')"/> Uhr</td>
        </tr>
    </table>
    
    <t t-set="exec_product_info" t-value="object.get_product_info()"/>
    <t t-if="object.description">
    <div style="background: #fff3cd; padding: 15px; border-radius: 5px; margin: 20px 0; border-left: 4px solid #ffc107;">
        <strong>Beratung zu:<t t-if="exec_product_info and exec_product_info.get('shortcode')"> <t t-out="exec_product_info.get('shortcode')"/></t></strong><br/>
        <pre style="white-space: pre-wrap; font-family: Arial, sans-serif; margin: 8px 0 0 0;"><t t-out="object.description"/></pre>
    </div>
    </t>
    
    <p>
        <a t-att-href="'https://service.dasei.eu/web#id=' + str(object.id) + '&amp;model=calendar.event&amp;view_type=form'" 
           style="display: inline-block; background: #3498db; color: white; padding: 10px 20px; text-decoration: none; border-radius: 5px;">
            Termin in Odoo öffnen
        </a>
    </p>
    
    <hr style="border: none; border-top: 1px solid #eee; margin: 30px 0;"/>
    <p style="color: #888; font-size: 12px;">
        Diese Benachrichtigung wurde automatisch vom Beratungsbuchungssystem generiert.
    </p>
</div>
]]></field>
            <field name="auto_delete" eval="False"/>
        </record>

        <!-- Rate limit alert email template -->
        <record id="mail_template_consulting_rate_limit_alert" model="mail.template">
            <field name="name">Consulting Booking: Rate Limit Alert</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="subject">[ALERT] Consulting Booking Rate Limit Exceeded</field>
            <field name="email_from">noreply@dasei.eu</field>
            <field name="email_to">admin@dasei.eu</field>
            <field name="body_html"><![CDATA[
<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
    <h2 style="color: #e74c3c;">⚠️ Rate Limit Alert</h2>
    
    <p>The consulting booking endpoint has exceeded the rate limit (10 bookings/hour).</p>
    
    <p>This may indicate:</p>
    <ul>
        <li>Automated abuse attempt</li>
        <li>Mass booking attack</li>
        <li>Legitimate high traffic (review and adjust limit if needed)</li>
    </ul>
    
    <p><strong>The booking service is now temporarily blocked.</strong></p>
    
    <p>To resume service, clear the rate limit counter in system parameters:</p>
    <code>consulting.booking.rate_limit_data</code>
    
    <hr style="border: none; border-top: 1px solid #eee; margin: 30px 0;"/>
    <p style="color: #888; font-size: 12px;">
        Server: service.dasei.eu
    </p>
</div>
]]></field>
            <field name="auto_delete" eval="False"/>
        </record>

        <!-- Reconfirmation request email (36h before) -->
        <record id="mail_template_consulting_reconfirm" model="mail.template">
            <field name="name">Consulting Booking: Reconfirmation Request</field>
            <field name="model_id" ref="calendar.model_calendar_event"/>
            <field name="subject">Unser Gespräch am {{ format_datetime(dt=object.start, tz='Europe/Berlin', dt_format='EEEE', lang_code='de_DE') }} - bist du dabei?</field>
            <field name="email_from">{{ (object.user_id.email_formatted or object.user_id.company_id.email_formatted or 'noreply@dasei.eu') }}</field>
            <field name="email_to">{{ object.partner_ids[:1].email }}</field>
            <field name="body_html"><![CDATA[
<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
    <t t-set="partner" t-value="object.partner_ids[:1]"/>
    <t t-set="partner_firstname" t-value="partner.firstname if hasattr(partner, 'firstname') and partner.firstname else (partner.name.split()[0] if partner.name else '')"/>
    
    <p>Hallo <strong><t t-out="partner_firstname"/></strong>,</p>
    
    <p>unser Gespräch rückt näher! Kurze Frage: Passt der Termin noch für dich?</p>
    
    <div style="background: #f8f9fa; padding: 20px; border-radius: 8px; margin: 20px 0;">
        <div style="color: #888; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px;">Fragen &amp; Antworten mit</div>
        <div style="font-size: 20px; font-weight: bold; margin: 5px 0 15px 0;"><t t-out="object.user_id.name"/></div>
        <div style="color: #666;"><t t-out="format_datetime(object.start, tz='Europe/Berlin', dt_format='EEEE, d. MMMM', lang_code='de_DE')"/></div>
        <div style="font-size: 16px;"><t t-out="format_datetime(object.start, tz='Europe/Berlin', dt_format='HH:mm', lang_code='de_DE')"/> Uhr</div>
    </div>
    
    <div style="margin: 30px 0; text-align: center;">
        <a t-att-href="object.get_confirm_url()" 
           style="display: inline-block; background: #27ae60; color: white; padding: 12px 30px; text-decoration: none; border-radius: 5px; margin-right: 10px;">
            ✓ Ja, bin dabei!
        </a>
        <a t-att-href="object.get_cancel_url()" 
           style="display: inline-block; background: #e74c3c; color: white; padding: 12px 30px; text-decoration: none; border-radius: 5px;">
            ✗ Muss absagen
        </a>
    </div>
    
    <p style="color: #666; font-size: 13px;">
        Falls ich nichts höre, melde ich mich kurz vor dem Termin nochmal.
    </p>
    
    <p style="margin-top: 20px;">
        Bis bald,<br/>
        <strong><t t-out="object.user_id.name"/></strong>
    </p>
    
    <hr style="border: none; border-top: 1px solid #eee; margin: 30px 0;"/>
    <p style="color: #888; font-size: 12px;">
        Bei Fragen erreichst du mich unter <t t-out="object.user_id.email or 'info@dasei.eu'"/>.
    </p>
</div>
]]></field>
            <field name="auto_delete" eval="True"/>
        </record>

        <!-- Consultant alert email (6h before, customer hasn't confirmed) -->
        <record id="mail_template_consulting_alert" model="mail.template">
            <field name="name">Consulting Booking: Consultant Alert</field>
            <field name="model_id" ref="calendar.model_calendar_event"/>
            <field name="subject">⚠️ Unbestätigter Termin in 6h: {{ object.partner_ids[:1].name }}</field>
            <field name="email_from">{{ object.user_id.company_id.email_formatted or 'noreply@dasei.eu' }}</field>
            <field name="email_to">{{ object.user_id.email }}</field>
            <field name="body_html"><![CDATA[
<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
    <t t-set="partner" t-value="object.partner_ids[:1]"/>
    <t t-set="exec_firstname" t-value="object.user_id.partner_id.firstname if hasattr(object.user_id.partner_id, 'firstname') and object.user_id.partner_id.firstname else (object.user_id.name.split()[0] if object.user_id.name else '')"/>
    
    <div style="background: #fff3cd; padding: 15px; border-radius: 5px; border-left: 4px solid #ffc107; margin-bottom: 20px;">
        <strong>⚠️ Achtung:</strong> Der Kunde hat den Beratungstermin noch nicht bestätigt.
    </div>
    
    <p>Hallo <strong><t t-out="exec_firstname"/></strong>,</p>
    
    <p>Folgender Beratungstermin wurde noch nicht vom Kunden bestätigt:</p>
    
    <table style="width: 100%; border-collapse: collapse; margin: 20px 0; background: #f8f9fa;">
        <tr>
            <td style="padding: 12px; border-bottom: 1px solid #ddd; width: 30%;"><strong>Kunde:</strong></td>
            <td style="padding: 12px; border-bottom: 1px solid #ddd;"><t t-out="partner.name"/></td>
        </tr>
        <tr>
            <td style="padding: 12px; border-bottom: 1px solid #ddd;"><strong>E-Mail:</strong></td>
            <td style="padding: 12px; border-bottom: 1px solid #ddd;"><t t-out="partner.email"/></td>
        </tr>
        <t t-if="partner.phone or partner.mobile">
        <tr>
            <td style="padding: 12px; border-bottom: 1px solid #ddd;"><strong>Telefon:</strong></td>
            <td style="padding: 12px; border-bottom: 1px solid #ddd;"><t t-out="partner.phone or partner.mobile"/></td>
        </tr>
        </t>
        <tr>
            <td style="padding: 12px; border-bottom: 1px solid #ddd;"><strong>Termin:</strong></td>
            <td style="padding: 12px; border-bottom: 1px solid #ddd;"><t t-out="format_datetime(object.start, tz='Europe/Berlin', dt_format='EEEE, d. MMMM y HH:mm', lang_code='de_DE')"/> Uhr</td>
        </tr>
    </table>
    
    <p>Du solltest den Kunden ggf. direkt kontaktieren, um den Termin zu bestätigen oder abzusagen.</p>
    
    <p>
        <a t-att-href="'https://service.dasei.eu/web#id=' + str(object.id) + '&amp;model=calendar.event&amp;view_type=form'" 
           style="display: inline-block; background: #3498db; color: white; padding: 10px 20px; text-decoration: none; border-radius: 5px;">
            Termin in Odoo öffnen
        </a>
    </p>
    
    <hr style="border: none; border-top: 1px solid #eee; margin: 30px 0;"/>
    <p style="color: #888; font-size: 12px;">
        Diese Warnung wurde automatisch generiert.
    </p>
</div>
]]></field>
            <field name="auto_delete" eval="False"/>
        </record>

        <!-- ═══════════════════════════════════════════════════════════════════════ -->
        <!-- S2L Email Inquiry Templates (D80.5)                                     -->
        <!-- Two-stage flow: Immediate confirmation + Exec draft for reply           -->
        <!-- ═══════════════════════════════════════════════════════════════════════ -->

        <!-- Stage 1: Immediate customer confirmation (auto-sent on crm.lead creation) -->
        <record id="mail_template_email_inquiry_customer" model="mail.template">
            <field name="name">Email Inquiry: Customer Confirmation</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="subject">Deine Anfrage ist eingegangen</field>
            <field name="email_from">{{ (object.user_id.email_formatted if object.user_id else object.company_id.email_formatted) or 'service@dasei.eu' }}</field>
            <field name="email_to">{{ object.email_from }}</field>
            <field name="body_html"><![CDATA[
<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
    
    <t t-set="contact_name" t-value="object.contact_name or object.partner_id.name or ''"/>
    <t t-set="firstname" t-value="contact_name.split()[0] if contact_name else 'du'"/>
    
    <p>Hallo <strong><t t-out="firstname"/></strong>,</p>
    
    <p>schön, dass du dich gemeldet hast! Deine Anfrage ist erfasst.</p>
    
    <!-- Ctype-specific header -->
    <t t-set="ctype" t-value="object.get_consulting_ctype() if hasattr(object, 'get_consulting_ctype') else 'general_inquiry'"/>
    <t t-set="header_config" t-value="{
        'event_inquiry': {'overline': 'Anfrage zu', 'headline': 'Eingegangen!'},
        'contact_inquiry': {'overline': 'Nachricht an', 'headline': 'Erhalten!'},
        'purchase_consultation': {'overline': 'Beratung zu', 'headline': 'Wir melden uns!'},
        'general_inquiry': {'overline': 'Anfrage', 'headline': 'Eingegangen!'},
    }"/>
    <t t-set="header" t-value="header_config.get(ctype, header_config['general_inquiry'])"/>
    
    <div style="background: #f8f9fa; padding: 20px; border-radius: 8px; margin: 20px 0;">
        <div style="color: #888; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px;">
            <t t-out="header['overline']"/>
            <t t-if="object.name and object.name != 'Email-Beratung: ' + (contact_name or '')"> <t t-out="object.name.replace('Email-Beratung: ', '').replace(contact_name, '').strip() or ''"/></t>
        </div>
        <div style="font-size: 20px; font-weight: bold; margin: 5px 0 0 0;"><t t-out="header['headline']"/></div>
    </div>
    
    <!-- Original inquiry summary -->
    <t t-if="object.description">
    <div style="background: #fff; padding: 15px; border-left: 4px solid #0066cc; margin: 20px 0;">
        <div style="color: #888; font-size: 11px; text-transform: uppercase; margin-bottom: 8px;">Deine Anfrage</div>
        <pre style="white-space: pre-wrap; font-family: Arial, sans-serif; margin: 0; color: #333;"><t t-out="object.description"/></pre>
    </div>
    </t>
    
    <p>Wir melden uns innerhalb von <strong>2 Werktagen</strong> bei dir.</p>
    
    <p style="margin-top: 20px;"><strong>Bis bald!</strong></p>
    
    <p style="color: #666; font-size: 14px;">PS: Du darfst gerne einfach auf diese Email antworten 😊</p>
    
    <hr style="border: none; border-top: 1px solid #eee; margin: 30px 0;"/>
    <p style="color: #888; font-size: 12px; text-align: center;">
        powered by <a href="https://theaterpedia.org" style="color: #888;">Theaterpedia</a>
    </p>
</div>
]]></field>
            <field name="lang">{{ object.partner_id.lang if object.partner_id else 'de_DE' }}</field>
            <field name="auto_delete" eval="True"/>
        </record>

        <!-- Stage 2: Exec notification + draft preparation -->
        <record id="mail_template_email_inquiry_exec" model="mail.template">
            <field name="name">Email Inquiry: Exec Notification</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="subject">📧 Neue Email-Anfrage: {{ object.contact_name or object.partner_id.name or 'Unbekannt' }}</field>
            <field name="email_from">{{ object.company_id.email_formatted or 'noreply@dasei.eu' }}</field>
            <field name="email_to">{{ object.user_id.email if object.user_id else 'service@dasei.eu' }}</field>
            <field name="body_html"><![CDATA[
<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
    
    <t t-set="partner" t-value="object.partner_id"/>
    <t t-set="exec_firstname" t-value="object.user_id.partner_id.firstname if object.user_id and hasattr(object.user_id.partner_id, 'firstname') and object.user_id.partner_id.firstname else (object.user_id.name.split()[0] if object.user_id and object.user_id.name else 'Team')"/>
    
    <p>Hallo <strong><t t-out="exec_firstname"/></strong>,</p>
    
    <p>du hast eine neue Email-Anfrage von: <strong><t t-out="object.contact_name or partner.name or 'Unbekannt'"/></strong></p>
    
    <table style="width: 100%; border-collapse: collapse; margin: 20px 0; background: #f8f9fa;">
        <tr>
            <td style="padding: 12px; border-bottom: 1px solid #ddd; width: 30%;"><strong>E-Mail:</strong></td>
            <td style="padding: 12px; border-bottom: 1px solid #ddd;"><t t-out="object.email_from or partner.email"/></td>
        </tr>
        <t t-if="object.phone or (partner and (partner.phone or partner.mobile))">
        <tr>
            <td style="padding: 12px; border-bottom: 1px solid #ddd;"><strong>Telefon:</strong></td>
            <td style="padding: 12px; border-bottom: 1px solid #ddd;"><t t-out="object.phone or partner.phone or partner.mobile"/></td>
        </tr>
        </t>
        <tr>
            <td style="padding: 12px; border-bottom: 1px solid #ddd;"><strong>Domain:</strong></td>
            <td style="padding: 12px; border-bottom: 1px solid #ddd;"><t t-out="object.consulting_domain_code or 'N/A'"/></td>
        </tr>
    </table>
    
    <t t-if="object.description">
    <div style="background: #fff3cd; padding: 15px; border-radius: 5px; margin: 20px 0; border-left: 4px solid #ffc107;">
        <strong>Anfrage-Details:</strong>
        <pre style="white-space: pre-wrap; font-family: Arial, sans-serif; margin: 8px 0 0 0;"><t t-out="object.description"/></pre>
    </div>
    </t>
    
    <p style="margin-top: 20px;">
        <a t-att-href="'https://service.dasei.eu/web#id=' + str(object.id) + '&amp;model=crm.lead&amp;view_type=form'" 
           style="display: inline-block; background: #3498db; color: white; padding: 10px 20px; text-decoration: none; border-radius: 5px; margin-right: 10px;">
            Anfrage öffnen
        </a>
        <a t-att-href="'https://service.dasei.eu/web#id=' + str(object.id) + '&amp;model=crm.lead&amp;view_type=form&amp;action=email_response'" 
           style="display: inline-block; background: #27ae60; color: white; padding: 10px 20px; text-decoration: none; border-radius: 5px;">
            ✉️ Antworten
        </a>
    </p>
    
    <!-- Draft response suggestion -->
    <div style="background: #e8f4f8; padding: 15px; border-radius: 5px; margin: 20px 0; border-left: 4px solid #17a2b8;">
        <strong>💡 Antwort-Vorlage:</strong>
        <p style="font-style: italic; color: #666; margin: 8px 0 0 0;">
            "Hallo <t t-out="(object.contact_name or '').split()[0] if object.contact_name else 'du'"/>,
            <br/><br/>
            vielen Dank für deine Anfrage!
            <br/><br/>
            [Hier deine Antwort einfügen]
            <br/><br/>
            Beste Grüße,<br/>
            <t t-out="exec_firstname"/>"
        </p>
    </div>
    
    <hr style="border: none; border-top: 1px solid #eee; margin: 30px 0;"/>
    <p style="color: #888; font-size: 12px;">
        Diese Benachrichtigung wurde automatisch vom Beratungsanfrage-System generiert.
    </p>
</div>
]]></field>
            <field name="auto_delete" eval="False"/>
        </record>
    </data>
</odoo>
