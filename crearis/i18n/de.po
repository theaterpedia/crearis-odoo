#. module: crearis
#: model:event.stage,description:event.event_stage_new
msgid "New event - initial entry, nothing confirmed yet"
msgstr "Neues Event - erster Eintrag, noch nichts bestätigt"

#. module: crearis
#: model:event.stage,description:event.event_stage_booked
msgid "Planned - date tentatively reserved, internal pre-planning"
msgstr "Vorgemerkt - Datum vorläufig reserviert, interne Vorplanung"

#. module: crearis
#: model:event.stage,description:crearis.event_stage_booked
msgid "Booked - fully planned and internally confirmed"
msgstr "Geplant - vollständig geplant und intern bestätigt"

#. module: crearis
#: model:event.stage,description:event.event_stage_announced
msgid "Announced - publicly visible, awaiting participant confirmations"
msgstr "Angekündigt - öffentlich sichtbar, Teilnehmerbestätigungen ausstehend"

#. module: crearis
#: model:event.stage,description:crearis.event_stage_current
msgid "Current - actively running, high certainty of execution"
msgstr "Aktuell - läuft aktiv, hohe Durchführungssicherheit"

#. module: crearis
#: model:event.stage,description:event.event_stage_done
msgid "Completed - event successfully finished"
msgstr "Vollständig - Event erfolgreich abgeschlossen"

#. module: crearis
#: model:event.stage,description:event.event_stage_cancelled
msgid "Cancelled - event was called off"
msgstr "Gestrichen - Event wurde abgesagt"
