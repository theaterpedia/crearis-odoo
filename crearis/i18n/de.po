#. module: crearis
#: model:mail.template,subject:crearis.mail_template_email_inquiry_customer
msgid "Your inquiry has been received"
msgstr "Deine Anfrage ist eingegangen"

#. module: crearis
#: model:mail.template,body_html:crearis.mail_template_email_inquiry_customer
msgid ""
"\n"
"<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\n"
"\n"
"    <t t-set=\"contact_name\" t-value=\"object.contact_name or object.partner_id.name or ''\"/>\n"
"    <t t-set=\"firstname\" t-value=\"contact_name.split()[0] if contact_name else 'there'\"/>\n"
"\n"
"    <p>Hi <strong><t t-out=\"firstname\"/></strong>,</p>\n"
"\n"
"    <p>great that you got in touch! Your inquiry has been recorded.</p>\n"
"\n"
"    <!-- Ctype-specific header -->\n"
"    <t t-set=\"ctype\" t-value=\"object.get_consulting_ctype() if hasattr(object, 'get_consulting_ctype') else 'general_inquiry'\"/>\n"
"    <t t-set=\"header_config\" t-value=\"{\n"
"        'event_inquiry': {'overline': 'Inquiry about', 'headline': 'Received!'},\n"
"        'contact_inquiry': {'overline': 'Message to', 'headline': 'Received!'},\n"
"        'purchase_consultation': {'overline': 'Consultation about', 'headline': 'We will be in touch!'},\n"
"        'general_inquiry': {'overline': 'Inquiry', 'headline': 'Received!'},\n"
"    }\"/>\n"
"    <t t-set=\"header\" t-value=\"header_config.get(ctype, header_config['general_inquiry'])\"/>\n"
"\n"
"    <div style=\"background: #f8f9fa; padding: 20px; border-radius: 8px; margin: 20px 0;\">\n"
"        <div style=\"color: #888; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px;\">\n"
"            <t t-out=\"header['overline']\"/>\n"
"            <t t-if=\"object.name and object.name != 'Email-Beratung: ' + (contact_name or '')\"> <t t-out=\"object.name.replace('Email-Beratung: ', '').replace(contact_name, '').strip() or ''\"/></t>\n"
"        </div>\n"
"        <div style=\"font-size: 20px; font-weight: bold; margin: 5px 0 0 0;\"><t t-out=\"header['headline']\"/></div>\n"
"    </div>\n"
"\n"
"    <!-- Original inquiry summary -->\n"
"    <t t-if=\"object.description\">\n"
"    <div style=\"background: #fff; padding: 15px; border-left: 4px solid #0066cc; margin: 20px 0;\">\n"
"        <div style=\"color: #888; font-size: 11px; text-transform: uppercase; margin-bottom: 8px;\">Your inquiry</div>\n"
"        <pre style=\"white-space: pre-wrap; font-family: Arial, sans-serif; margin: 0; color: #333;\"><t t-out=\"object.description\"/></pre>\n"
"    </div>\n"
"    </t>\n"
"\n"
"    <p>We will get back to you within <strong>2 working days</strong>.</p>\n"
"\n"
"    <p style=\"margin-top: 20px;\"><strong>Best regards,</strong></p>\n"
"\n"
"    <p style=\"color: #666; font-size: 14px;\">PS: Feel free to simply reply to this email 😊</p>\n"
"\n"
"    <hr style=\"border: none; border-top: 1px solid #eee; margin: 30px 0;\"/>\n"
"    <p style=\"color: #888; font-size: 12px; text-align: center;\">\n"
"        powered by <a href=\"https://theaterpedia.org\" style=\"color: #888;\">Theaterpedia</a>\n"
"    </p>\n"
"</div>\n"
""
msgstr ""
"\n"
"<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\n"
"    \n"
"    <t t-set=\"contact_name\" t-value=\"object.contact_name or object.partner_id.name or ''\"></t>\n"
"    <t t-set=\"firstname\" t-value=\"contact_name.split()[0] if contact_name else 'du'\"></t>\n"
"    \n"
"    <p style=\"margin:0px 0 12px 0;box-sizing:border-box;\">Hallo <strong style=\"box-sizing:border-box;font-weight:bolder;\"><t t-out=\"firstname\"></t></strong>,</p>\n"
"    \n"
"    <p style=\"margin:0px 0 12px 0;box-sizing:border-box;\">schön, dass du dich gemeldet hast! Deine Anfrage ist erfasst.</p>\n"
"    \n"
"    \n"
"    <t t-set=\"ctype\" t-value=\"object.get_consulting_ctype() if hasattr(object, 'get_consulting_ctype') else 'general_inquiry'\"></t>\n"
"    <t t-set=\"header_config\" t-value=\"{\n"
"        'event_inquiry': {'overline': 'Anfrage zu', 'headline': 'Eingegangen!'},\n"
"        'contact_inquiry': {'overline': 'Nachricht an', 'headline': 'Erhalten!'},\n"
"        'purchase_consultation': {'overline': 'Beratung zu', 'headline': 'Wir melden uns!'},\n"
"        'general_inquiry': {'overline': 'Anfrage', 'headline': 'Eingegangen!'},\n"
"    }\"></t>\n"
"    <t t-set=\"header\" t-value=\"header_config.get(ctype, header_config['general_inquiry'])\"></t>\n"
"    \n"
"    <div style=\"background: #f8f9fa; padding: 20px; border-radius: 8px; margin: 20px 0;\">\n"
"        <div style=\"color: #888; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px;\">\n"
"            <t t-out=\"header['overline']\"></t>\n"
"            <t t-if=\"object.name and object.name != 'Email-Beratung: ' + (contact_name or '')\"> <t t-out=\"object.name.replace('Email-Beratung: ', '').replace(contact_name, '').strip() or ''\"></t></t>\n"
"        </div>\n"
"        <div style=\"font-size: 20px; font-weight: bold; margin: 5px 0 0 0;\"><t t-out=\"header['headline']\"></t></div>\n"
"    </div>\n"
"    \n"
"    \n"
"    <t t-if=\"object.description\">\n"
"    <div style=\"background: #fff; padding: 15px; border-left: 4px solid #0066cc; margin: 20px 0;\">\n"
"        <div style=\"color: #888; font-size: 11px; text-transform: uppercase; margin-bottom: 8px;\">Deine Anfrage</div>\n"
"        <pre style=\"box-sizing:border-box;white-space-collapse:preserve;text-wrap-mode:wrap;overflow-y:auto;overflow-x:auto;unicode-bidi:bidi-override;direction:ltr;font-size:0.875em;white-space: pre-wrap; font-family: Arial, sans-serif; margin: 0; color: #333;\"><t t-out=\"object.description\"></t></pre>\n"
"    </div>\n"
"    </t>\n"
"    \n"
"    <p style=\"margin:0px 0 12px 0;box-sizing:border-box;\">Wir melden uns innerhalb von <strong style=\"box-sizing:border-box;font-weight:bolder;\">2 Werktagen</strong> bei dir.</p>\n"
"    \n"
"    <p style=\"margin:20px 0 12px 0;box-sizing:border-box;margin-top: 20px;\"><strong style=\"box-sizing:border-box;font-weight:bolder;\">Liebe Grüße,</strong></p>\n"
"    \n"
"    <p style=\"margin:0px 0 12px 0;box-sizing:border-box;color: #666; font-size: 14px;\">PS: Du darfst gerne einfach auf diese Email antworten 😊</p>\n"
"    \n"
"    <hr style=\"box-sizing: border-box; height: 1px; opacity: 0.25; background-color: currentcolor; color: #495057; border-width: 1px medium medium; border-style: solid none none; border-color: #eeeeee currentcolor currentcolor; border-image: none; margin: 30px 0px;\">\n"
"    <p style=\"margin:0px 0 12px 0;box-sizing:border-box;color: #888; font-size: 12px; text-align: center;\">\n"
"        powered by <a href=\"https://theaterpedia.org\" style=\"text-decoration:none;box-sizing:border-box;color: #888;\">Theaterpedia</a>\n"
"    </p>\n"
"</div>\n"
""
