msgid "booked"
msgstr "rezervovaný"

#. module: crearis
#: model:event.stage,name:event.event_stage_announced
msgid "announced"
msgstr "oznámený"

#. module: crearis
#: model:event.stage,name:crearis.event_stage_current
msgid "current"
msgstr "aktuální"

#. module: crearis
