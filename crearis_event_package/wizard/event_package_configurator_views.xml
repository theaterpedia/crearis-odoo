<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Event Package Configurator Wizard -->
    <record id="view_event_package_configurator_form" model="ir.ui.view">
        <field name="name">event.package.configurator.form</field>
        <field name="model">event.package.configurator</field>
        <field name="arch" type="xml">
            <form string="Configure Event Package">
                <group>
                    <group>
                        <field name="sale_order_line_id" readonly="1"/>
                        <field name="product_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="partner_id" readonly="1"/>
                        <field name="product_tmpl_id" invisible="1"/>
                    </group>
                </group>
                <separator string="Select Events for Each Slot"/>
                <field name="line_ids">
                    <tree editable="bottom">
                        <field name="event_type_id" readonly="1"/>
                        <field name="event_id" 
                               domain="[('id', 'in', available_event_ids)]"
                               options="{'no_create': True}"/>
                        <field name="available_event_ids" invisible="1"/>
                        <field name="package_event_line_id" invisible="1"/>
                    </tree>
                </field>
                <footer>
                    <button name="action_confirm" type="object" 
                            string="Save Selections" class="btn-primary"/>
                    <button name="action_confirm_and_register" type="object"
                            string="Save &amp; Create Registrations" class="btn-secondary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Configurator Line Form (for embedded editing) -->
    <record id="view_event_package_configurator_line_form" model="ir.ui.view">
        <field name="name">event.package.configurator.line.form</field>
        <field name="model">event.package.configurator.line</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="event_type_id" readonly="1"/>
                    <field name="event_id" 
                           domain="[('id', 'in', available_event_ids)]"
                           options="{'no_create': True}"/>
                    <field name="available_event_ids" invisible="1"/>
                </group>
            </form>
        </field>
    </record>

    <!-- Action for the configurator wizard -->
    <record id="action_event_package_configurator" model="ir.actions.act_window">
        <field name="name">Configure Event Package</field>
        <field name="res_model">event.package.configurator</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
