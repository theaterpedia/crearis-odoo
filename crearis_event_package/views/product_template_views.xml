<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend Product Template Form for Event Package type -->
    <record id="product_template_form_view_event_package" model="ir.ui.view">
        <field name="name">product.template.form.event.package</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Event Package" name="event_package"
                      attrs="{'invisible': [('detailed_type', '!=', 'event_package')]}">
                    <group>
                        <group string="Package Configuration">
                            <field name="package_edition_code"/>
                            <field name="package_date_start"/>
                            <field name="package_date_end"/>
                        </group>
                        <group string="Cancellation Policy">
                            <field name="cancellation_period_days"/>
                            <field name="cancellation_fee"/>
                        </group>
                    </group>
                    <group>
                        <group string="Milestones">
                            <field name="activation_days_before"/>
                            <field name="use_completion_milestone"/>
                            <field name="completion_days_after" 
                                   attrs="{'invisible': [('use_completion_milestone', '=', False)]}"/>
                        </group>
                        <group string="Requirements">
                            <field name="requires_consulting"/>
                        </group>
                    </group>
                    <separator string="Included Event Types"/>
                    <field name="package_event_type_ids" nolabel="1" mode="tree">
                        <tree editable="bottom" create="false" delete="true">
                            <field name="display_name" string="Event Type"/>
                            <field name="is_template_code" string="Template Code"/>
                            <field name="template_parent_id" string="Parent Category"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Product Template Tree View with Package indicator -->
    <record id="product_template_tree_view_event_package" model="ir.ui.view">
        <field name="name">product.template.tree.event.package</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='type']" position="after">
                <field name="package_edition_code" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- Event Package Products Action -->
    <record id="action_event_package_products" model="ir.actions.act_window">
        <field name="name">Event Packages</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('detailed_type', '=', 'event_package')]</field>
        <field name="context">{'default_detailed_type': 'event_package', 'default_type': 'service'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create an Event Package
            </p>
            <p>
                Event packages bundle multiple events together as a single purchasable product.
                Configure which event types are included and the date range for event selection.
            </p>
        </field>
    </record>

    <!-- Menu Item under Events -->
    <menuitem id="menu_event_package_products"
              name="Event Packages"
              parent="event.event_main_menu"
              action="action_event_package_products"
              sequence="25"/>
</odoo>
