<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron Job: Sync Agenda every hour -->
        <record id="cron_sync_agenda" model="ir.cron">
            <field name="name">Sync Microsoft Agenda</field>
            <field name="model_id" ref="model_crearis_agenda_sync"/>
            <field name="state">code</field>
            <field name="code">model.cron_sync_all_companies()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
            <field name="doall">False</field>
        </record>
    </data>
</odoo>
