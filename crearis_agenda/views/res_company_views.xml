<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend Company Form View with MS Agenda Settings -->
    <record id="view_company_form_ms_agenda" model="ir.ui.view">
        <field name="name">res.company.form.ms.agenda</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="MS Agenda Sync" name="ms_agenda">
                    <group string="Microsoft Graph API Credentials">
                        <group>
                            <field name="ms_agenda_tenant_id"/>
                            <field name="ms_agenda_client_id"/>
                            <field name="ms_agenda_client_secret" password="True"/>
                        </group>
                        <group>
                            <field name="ms_agenda_site_id"/>
                            <field name="ms_agenda_configured" readonly="1"/>
                        </group>
                    </group>

                    <group string="Sync Configuration">
                        <group>
                            <field name="ms_agenda_sync_level"/>
                            <field name="ms_agenda_sync_enabled"/>
                            <field name="ms_agenda_last_sync" readonly="1"/>
                        </group>
                        <group>
                            <button name="action_test_ms_connection" 
                                    type="object" 
                                    string="Test Connection"
                                    class="btn-secondary"
                                    attrs="{'invisible': [('ms_agenda_configured', '=', False)]}"/>
                            <button name="action_sync_now" 
                                    type="object" 
                                    string="Sync Now"
                                    class="btn-primary"
                                    attrs="{'invisible': [('ms_agenda_configured', '=', False)]}"/>
                        </group>
                    </group>

                    <group string="SharePoint List GUIDs" attrs="{'invisible': [('ms_agenda_configured', '=', False)]}">
                        <group>
                            <field name="ms_list_veranstaltungen"/>
                            <field name="ms_list_veranstaltungscodes"/>
                            <field name="ms_list_referenten"/>
                            <field name="ms_list_planungsstatus"/>
                            <field name="ms_list_seminarzeiten"/>
                        </group>
                        <group>
                            <field name="ms_list_contacts"/>
                            <field name="ms_list_kursteilnehmer"/>
                            <field name="ms_list_veranstaltungsteilnehmer"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
