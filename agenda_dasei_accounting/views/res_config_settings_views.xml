<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_installment" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.installment</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='account_tax_settings']" position="after">
                <h2>Installment Invoicing</h2>
                <div class="row mt16 o_settings_container">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="default_installment_rate"/>
                            <div class="text-muted">
                                Default monthly rate pre-filled in the installment wizard (EUR)
                            </div>
                            <div class="content-group">
                                <div class="mt16">
                                    <field name="default_installment_rate"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
