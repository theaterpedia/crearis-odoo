<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!--
            Assign Bildungsleistungen category to existing DASEi products.
            This sets income account (4110) and enables fiscal position
            matching for §4 Nr. 21 UStG tax exemption.
        -->

        <record id="agenda_dasei.product_modul_a" model="product.template">
            <field name="categ_id" ref="product_category_bildungsleistung"/>
        </record>

        <record id="agenda_dasei.product_modul_b" model="product.template">
            <field name="categ_id" ref="product_category_bildungsleistung"/>
        </record>

        <record id="agenda_dasei.product_modul_c" model="product.template">
            <field name="categ_id" ref="product_category_bildungsleistung"/>
        </record>

        <record id="agenda_dasei.product_modul_d" model="product.template">
            <field name="categ_id" ref="product_category_bildungsleistung"/>
        </record>

    </data>
</odoo>
